{
  "name": "kwm-1924",
  "version": "1.0.0",
  "description": "Website kwm-1924.de (Astro, statisch)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "prettier --check . && eslint . && astro check && astro build",
    "prototyp": "node prototyp/tools/build.mjs && python3 -m http.server 4392 -d prototyp/site",
    "test:ausgangsstand": "ZIEL=prototyp playwright test tests/optik.spec.ts --update-snapshots",
    "test:optik": "playwright test tests/optik.spec.ts",
    "test": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ichbinreich335/KWM.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Ichbinreich335/KWM/issues"
  },
  "homepage": "https://github.com/Ichbinreich335/KWM#readme",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "wrangler": "^4.138.0"
  },
  "private": true,
  "dependencies": {
    "astro": "^7.3.5"
  }
