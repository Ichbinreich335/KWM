---
interface Gemeinsam {
  /** Id der Überschrift, auf die `aria-labelledby` zeigt */
  titelId?: string;
  /** Lede als `div` statt `p`, wenn sie Listen oder Links enthält (Fehlerseite) */
  ledeAls?: 'p' | 'div';
  /** Einblend-Animation für Titel, Lede und Bild; die Fehlerseite blendet nichts ein */
  einblenden?: boolean;
  /** Nur mit Slot `bild` sinnvoll */
  bildunterschrift?: string;
  /** Bild als randloser Streifen (Typ `anker`), nur mit Slot `bild` sinnvoll */
  streifen?: boolean;
  /** Zusätzliche Klassen für die Platzierung durch die Seite */
  class?: string | undefined;
}

type Props = Gemeinsam &
  (
    | {
        typ: 'name';
        /** Textseiten ohne Bild (Impressum, Datenschutz, AGB, Versand, Zahlung) */
        textseite?: boolean;
      }
    | { typ: 'meta' | 'flaeche' | 'anker' }
  );

const {
  typ,
  titelId = 'page-title',
  ledeAls = 'p',
  einblenden = true,
  bildunterschrift,
  streifen = false,
} = Astro.props;
const textseite = Astro.props.typ === 'name' && (Astro.props.textseite ?? false);
const klasse = Astro.props.class;
const hatBild = Astro.slots.has('bild');
const einblendung = (art: 'words' | 'fade' | 'img') => (einblenden ? art : undefined);
---

<section
  class:list={[
    'page-hero',
    `page-hero--${typ}`,
    { 'page-hero--text': textseite, 'on-anker': typ === 'anker' },
    klasse,
    'grid',
  ]}
  aria-labelledby={titelId}
>
  <h1 class="page-hero__title" id={titelId} data-reveal={einblendung('words')}>
    <slot name="titel" />
  </h1>
  {ledeAls === 'div' ? (
    <div class="page-hero__lede">
      <slot name="lede" />
    </div>
  ) : (
    <p class="page-hero__lede" data-reveal={einblendung('fade')}>
      <slot name="lede" />
    </p>
  )}
  {hatBild && (
    <figure class:list={['page-hero__media', { 'page-hero__media--strip': streifen }]} data-reveal={einblendung('img')}>
      <slot name="bild" />
      {bildunterschrift && <figcaption>{bildunterschrift}</figcaption>}
    </figure>
  )}
  <slot />
</section>

<style>
  /* Seitenkopf: vier Typen (DESIGN.md, Seitenkopf). Gemeinsam: Raster, Abstand oben, Titel, Lede, optionales Bild. */
  .page-hero {
    --hero-img: min(72vh, 760px);
    padding-top: calc(var(--head) + clamp(48px, 6vw, 96px));
    padding-bottom: calc(var(--section) * 0.6);
    row-gap: var(--head-gap);
    align-items: end;
  }
  .page-hero:has(.page-hero__media) {
    padding-bottom: 0;
  }
  .page-hero__title {
    grid-column: 1 / 9;
    font-family: var(--f-display);
    font-size: var(--t-title);
    line-height: var(--t-title-lh);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .page-hero__lede {
    grid-column: 9 / 13;
    font-family: var(--f-text);
    font-size: var(--t-quote);
    line-height: var(--t-quote-lh);
    margin: 0;
    text-wrap: pretty;
  }
  .page-hero__media {
    grid-column: 1 / -1;
    margin-inline: calc(var(--m) * -1);
  }
  .page-hero__media :global(img) {
    width: 100%;
    height: var(--hero-img);
    object-fit: cover;
  }
  .page-hero__media--strip :global(img) {
    height: auto;
    aspect-ratio: 2560 / 398;
    min-height: 180px;
  }
  .page-hero__media figcaption {
    padding: 0 var(--m) 20px;
  }

  /* Typ Anker: dunkel, Titel links, Lede rechts, Panorama randlos am Fuß (Werkstatt) */

  /* Typ Name: hell, riesiger Name über die ganze Breite, Lede rechts, Bild randlos darunter (Young-Jae Lee, Aktuelles, Fehlerseite) */
  .page-hero--name .page-hero__title {
    grid-column: 1 / -1;
    font-size: var(--t-mega);
    line-height: var(--t-mega-lh);
    letter-spacing: -0.035em;
  }
  .page-hero--name .page-hero__lede {
    grid-column: 6 / 13;
    max-width: 46ch;
    justify-self: end;
  }
  .page-hero--name:has(.page-hero__media) {
    row-gap: var(--head-gap);
  }
  .page-hero--name .page-hero__media figcaption {
    color: var(--ink-2);
    padding-top: 10px;
  }

  /* Typ Meta: hell, Titel oben, links schmale Meta-Spalte, rechts ein großes Bild, das an den Rand läuft (Meisterstücke) */
  .page-hero--meta .page-hero__title {
    grid-column: 1 / -1;
  }
  .page-hero--meta .page-hero__lede {
    grid-column: 1 / 5;
    align-self: start;
    padding-right: var(--g);
  }
  .page-hero--meta .page-hero__media {
    grid-column: 5 / -1;
    margin-inline: 0 calc(var(--m) * -1);
  }
  .page-hero--meta .page-hero__media :global(img) {
    height: auto;
    aspect-ratio: 2000 / 931;
  }
  .page-hero--meta .page-hero__media figcaption {
    padding: 10px 0 0;
    color: var(--ink-2);
  }
  .page-hero--meta :global(.visit-hours__times) {
    grid-column: 5 / -1;
  }
  .page-hero--meta:has(.page-hero__media) {
    padding-bottom: var(--head-gap);
  }
  .page-hero--meta:not(:has(.page-hero__media)) {
    padding-bottom: calc(var(--section) * 0.6);
  }

  /* Typ Fläche: --ground-2, Titel und Lede, darunter eine Reihe Produktfotos auf einem Sockel (Manufaktur) */
  .page-hero--flaeche {
    background: var(--ground-2);
    --cover: var(--ground-2);
    padding-bottom: 0;
  }

  /* Typ Name ohne Bild: Textseiten (Impressum, Datenschutz, AGB, Versand, Zahlung), Lede in lesbarer Zeilenlänge */
  .page-hero--text {
    padding-bottom: calc(var(--section) * 0.4);
  }
  .page-hero--text .page-hero__title {
    grid-column: 1 / -1;
    font-size: var(--t-title);
    line-height: var(--t-title-lh);
  }
  .page-hero--text .page-hero__lede {
    grid-column: 4 / 11;
    max-width: 46ch;
    justify-self: start;
  }

  @media (max-width: 900px) {
    .page-hero__title,
    .page-hero__lede,
    .page-hero--name .page-hero__lede,
    .page-hero--meta .page-hero__lede {
      grid-column: 1 / -1;
    }
    .page-hero--name .page-hero__lede {
      justify-self: start;
    }
    .page-hero--meta .page-hero__media {
      grid-column: 1 / -1;
      margin-inline: calc(var(--m) * -1);
    }
    .page-hero--meta :global(.visit-hours__times) {
      grid-column: 1 / -1;
    }
    .page-hero--meta .page-hero__media figcaption {
      padding: 10px var(--m) 0;
    }
    .page-hero--meta .page-hero__media :global(img) {
      aspect-ratio: 4 / 3;
    }
    .page-hero__media--strip :global(img) {
      min-height: 150px;
    }
    .page-hero--flaeche {
      padding-bottom: calc(var(--section) * 0.5);
    }
    .page-hero {
      --hero-img: 56svh;
    }
    .page-hero--text .page-hero__lede {
      grid-column: 1 / -1;
    }
  }
</style>
