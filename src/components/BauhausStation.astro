---
// Bauhaus-Station der Startseite: Herkunft und Gebrauch. Ein Satz als Überschrift („Seit 1927 in der Tradition des
// Bauhauses.“) mit der Jahreszahl als Marke, darunter die Tafel mit vier Tellern und der Grundsatz des Programms.
import LinkArrow from './LinkArrow.astro';
import TellerTafel from './TellerTafel.astro';
---

<section class="bauhaus" id="bauhaus" aria-labelledby="bauhaus-titel">
  <div class="bauhaus__kopf grid">
    {/* Eine Überschrift, ein Satz: „Seit“ klein auf der Grundlinie der Zahl, der Rest schließt rechts an */}
    <h2 class="bauhaus__titel" id="bauhaus-titel" data-reveal="fade">
      <span class="bauhaus__marke">
        <span class="bauhaus__seit">Seit</span>
        <span class="bauhaus__jahr">1927</span>
      </span>
      <span class="bauhaus__satz">in der Tradition des Bauhauses.</span>
    </h2>
    <p class="bauhaus__text" data-reveal="fade">
      Johannes Leßmann, Schüler des Bauhaus-Keramikers Otto Lindig, stellt die Werkstatt auf Serienkeramik um – bei
      strenger Einhaltung der Formgebungsprinzipien des Bauhauses.
    </p>
  </div>
  <TellerTafel />
  <div class="bauhaus__fuss grid">
    <p class="bauhaus__grundsatz" data-reveal="fade">
      Jedes Stück muss gut zu drehen sein und auch zu benutzen.
    </p>
    <LinkArrow href="/manufaktur">Zum Manufakturprogramm</LinkArrow>
  </div>
</section>

<style>
  .bauhaus {
    padding-block: var(--section);
  }

  /* Kopf: Marke Spalte 1–7, Satz und Text Spalte 8–12 auf ihrer Grundlinie, Haarlinie wie beim Abschnittskopf */
  .bauhaus__kopf {
    align-items: end;
    row-gap: 20px;
    margin-inline: var(--m);
    padding: 0 0 20px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: var(--head-gap);
  }
  .bauhaus__titel {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: end;
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--t-statement);
    line-height: var(--t-statement-lh);
    letter-spacing: -0.02em;
  }
  .bauhaus__marke {
    grid-column: 1 / 8;
    display: flex;
    align-items: baseline;
    gap: 0.3em;
  }
  .bauhaus__jahr {
    font-size: var(--t-marke);
    line-height: var(--t-marke-lh);
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums;
  }
  .bauhaus__satz {
    grid-column: 8 / 13;
    text-wrap: balance;
  }
  .bauhaus__text {
    grid-column: 8 / 13;
    max-width: 44ch;
    margin: 0;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink-2);
  }

  /* Fuß unter der Tafel: Grundsatz links, Link rechts */
  .bauhaus__fuss {
    align-items: baseline;
    row-gap: 20px;
    padding-top: var(--head-gap);
  }
  .bauhaus__grundsatz {
    grid-column: 1 / 9;
    max-width: 30ch;
    margin: 0;
    font-family: var(--f-text);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
    text-wrap: pretty;
  }
  .bauhaus__fuss :global(.link-arrow) {
    grid-column: 9 / 13;
    justify-self: start;
  }

  @media (max-width: 900px) {
    .bauhaus__marke,
    .bauhaus__satz,
    .bauhaus__text,
    .bauhaus__grundsatz,
    .bauhaus__fuss :global(.link-arrow) {
      grid-column: 1 / -1;
    }
    .bauhaus__titel {
      row-gap: 8px;
    }
  }
</style>
