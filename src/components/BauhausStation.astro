---
// Bauhaus-Station der Startseite in drei Entwürfen (Vorschau): ?bauhaus=1|2|3 wählt einen, ohne Angabe gilt 1.
// Das Kopf-Skript in BaseLayout.astro setzt data-bauhaus an <html>, bevor die Seite zeichnet (kein Sprung).
// Nach der Entscheidung bleibt nur der gewählte Entwurf, Umschalter und die beiden anderen entfallen.
import Bild from './Bild.astro';
import Figure from './Figure.astro';
import LinkArrow from './LinkArrow.astro';
import SectionHead from './SectionHead.astro';
import { geschirr } from '../data/manufaktur';

// Entwurf 3: die vier Teller im Foto von links nach rechts, Namen und Maße aus dem Programm (manufaktur.ts)
const tellerTeile =
  geschirr.find((gruppe) => gruppe.schluessel === 'teller')?.saetze.flatMap((satz) => satz.teile) ?? [];
const tellerReihe = ['15', '16', '14', '13'].map((nummer) => {
  const teil = tellerTeile.find((eintrag) => eintrag.programmnr === nummer);
  if (!teil) throw new Error(`Teller Nr. ${nummer} fehlt in manufaktur.ts`);
  return teil;
});
// Weiche Trennung vor „teller“, damit die schmalen Spalten am Handy an der Wortfuge umbrechen
const trennbar = (name: string) => name.replace(/(\p{L})teller/u, '$1\u00ADteller');
---

<div class="bauhaus" id="bauhaus">
  {/* Entwurf 1: drei Grundsätze der Werkstatt im strengen Raster neben einem Ensemble aus dem Programm */}
  <section class="entwurf entwurf--1" aria-labelledby="bauhaus-1-titel">
    <SectionHead typ="start" titelId="bauhaus-1-titel">
      <Fragment slot="titel">Seit 1927 in der Tradition des Bauhauses.</Fragment>
      <LinkArrow href="/manufaktur">Zum Manufakturprogramm</LinkArrow>
    </SectionHead>
    <div class="satz grid">
      <Figure class="satz__bild">
        <Bild
          src="/img/kwm/teekanne.webp"
          width="1030"
          height="687"
          loading="lazy"
          sizes="(min-width: 900px) 50vw, 100vw"
          alt="Weiße Teekanne und dunkle Teeschale auf einem hellen, rechteckigen Plattenteller"
        />
      </Figure>
      <ol class="satz__liste" aria-label="Grundsätze der Werkstatt">
        <li data-reveal="fade">
          <span class="satz__nr" aria-hidden="true">
            1
          </span>
          <p>Wir gehen immer von geometrischen Grundformen aus.</p>
        </li>
        <li data-reveal="fade">
          <span class="satz__nr" aria-hidden="true">
            2
          </span>
          <p>Jedes Stück muss gut zu drehen sein und auch zu benutzen.</p>
        </li>
        <li data-reveal="fade">
          <span class="satz__nr" aria-hidden="true">
            3
          </span>
          <p>Alle Teile eines Geschirrs, gleich welcher Farbe, sollten miteinander kombinierbar sein.</p>
        </li>
      </ol>
      <p class="satz__nachweis">Teekanne, Teeschale und Plattenteller aus dem Manufakturprogramm</p>
    </div>
  </section>

  {/* Entwurf 2: Herkunft – die Jahreszahl als Marke neben dem Regal mit Serienware, darunter ein Satz zur Herkunft */}
  <section class="entwurf entwurf--2" aria-labelledby="bauhaus-2-titel">
    <div class="herkunft grid">
      <h2 class="herkunft__titel" id="bauhaus-2-titel">
        <span class="herkunft__jahr" data-reveal="fade">
          1927
        </span>
        <span class="herkunft__satz" data-reveal="fade">
          In der Tradition des Bauhauses.
        </span>
      </h2>
      <Figure class="herkunft__bild" unterschrift="Serienware vor dem ersten Brand · Foto: Haydar Koyupinar">
        <Bild
          src="/img/kwm/regal.webp"
          width="954"
          height="905"
          loading="lazy"
          sizes="(min-width: 900px) 34vw, 100vw"
          alt="Regal voller ungebrannter Tassen, Schalen, Teller und Krüge aus dem Manufakturprogramm"
        />
      </Figure>
      <div class="herkunft__text">
        <p data-reveal="fade">
          Johannes Leßmann, Schüler des Bauhaus-Keramikers Otto Lindig, stellt die Werkstatt auf Serienkeramik um – bei
          strenger Einhaltung der Formgebungsprinzipien des Bauhauses.
        </p>
        <p data-reveal="fade">
          1986 nehmen Young-Jae Lee und Hildegard Eggemann das Manufakturprogramm wieder auf. Den Blindstempel der
          Werkstatt tragen die Stücke seit 1930.
        </p>
        <LinkArrow href="/werkstatt#chronik">Zur Chronik</LinkArrow>
      </div>
    </div>
  </section>

  {/* Entwurf 3: Form folgt Gebrauch – eine Tafel wie im Musterkatalog: vier Teller, darunter Nummer, Name und Maß */}
  <section class="entwurf entwurf--3" aria-labelledby="bauhaus-3-titel">
    <SectionHead typ="start" titelId="bauhaus-3-titel">
      <Fragment slot="titel">Seit 1927 in der Tradition des Bauhauses.</Fragment>
      <p data-reveal="fade">Jedes Stück muss gut zu drehen sein und auch zu benutzen.</p>
    </SectionHead>
    <figure class="tafel">
      <div class="tafel__bild" data-reveal="img">
        <Bild
          src="/img/kwm/teller-reihe.webp"
          width="2560"
          height="1060"
          loading="lazy"
          sizes="100vw"
          alt="Vier Stücke aus dem Manufakturprogramm von oben: zwei Teller und ein kleiner Teller in gesprenkeltem Weiß, ein Unterteller in Seladon"
        />
      </div>
      <figcaption class="tafel__legende">
        <ol aria-label="Die Stücke im Bild von links nach rechts">
          {tellerReihe.map((teil) => (
            <li>
              <span class="tafel__nr">Nr. {teil.programmnr}</span>
              <span class="tafel__name">{trennbar(teil.name)}</span>
              <span class="tafel__mass">{teil.masse}</span>
            </li>
          ))}
        </ol>
      </figcaption>
    </figure>
    <div class="tafel__fuss grid">
      <p class="tafel__satz" data-reveal="fade">
        Alle Teile eines Geschirrs, gleich welcher Farbe, sollten miteinander kombinierbar sein.
      </p>
      <LinkArrow href="/manufaktur">Zum Manufakturprogramm</LinkArrow>
    </div>
  </section>
</div>

<style>
  .bauhaus {
    padding-block: var(--section);
  }

  /* Umschaltung in der Vorschau: ohne Angabe Entwurf 1 */
  .entwurf--2,
  .entwurf--3,
  :global(html[data-bauhaus='2']) .entwurf--1,
  :global(html[data-bauhaus='3']) .entwurf--1 {
    display: none;
  }
  :global(html[data-bauhaus='2']) .entwurf--2,
  :global(html[data-bauhaus='3']) .entwurf--3 {
    display: block;
  }

  /* Entwurf 1: Bild Spalte 1–6 als Freisteller auf Fläche, Grundsätze Spalte 8–12; erste und letzte Linie stehen auf den Bildkanten */
  .satz {
    align-items: stretch;
    row-gap: 10px;
  }
  .satz__bild {
    grid-column: 1 / 7;
    grid-row: 1;
    background: var(--ground-2);
  }
  .satz__bild :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: var(--werk-max);
    object-fit: cover;
    mix-blend-mode: multiply;
  }
  .satz__nachweis {
    grid-column: 1 / 7;
    grid-row: 2;
    margin: 0;
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
  }
  .satz__liste {
    grid-column: 8 / 13;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }
  .satz__liste li {
    display: grid;
    grid-template-columns: 1.6em minmax(0, 1fr);
    align-items: baseline;
    padding-top: 14px;
    border-top: 1px solid var(--ink);
    font-family: var(--f-text);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
  }
  .satz__liste li:last-child {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ink);
  }
  .satz__nr {
    font-family: var(--f-display);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .satz__liste p {
    margin: 0;
    text-wrap: pretty;
  }

  /* Entwurf 2: Jahreszahl als Marke (Spalte 1–8) und Regal (9–12) auf einer Unterkante, darunter Text im selben Raster */
  .herkunft {
    align-items: end;
    row-gap: var(--head-gap);
  }
  .herkunft__titel {
    grid-column: 1 / 9;
    margin: 0;
    font-weight: 400;
  }
  .herkunft__jahr {
    display: block;
    font-family: var(--f-display);
    font-size: var(--t-marke);
    line-height: var(--t-marke-lh);
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums;
    margin-left: -0.04em;
  }
  .herkunft__satz {
    display: block;
    margin-top: 24px;
    font-family: var(--f-display);
    font-size: var(--t-statement);
    line-height: var(--t-statement-lh);
    letter-spacing: -0.02em;
  }
  .herkunft__bild {
    grid-column: 9 / 13;
    position: relative;
  }
  .herkunft__bild :global(img) {
    width: 100%;
    aspect-ratio: 954 / 905;
    max-height: var(--werk-max);
    object-fit: cover;
  }
  .herkunft__text {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    row-gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink-2);
  }
  .herkunft__text p {
    max-width: 44ch;
    margin: 0;
  }
  .herkunft__text p:nth-child(1) {
    grid-column: 1 / 5;
  }
  .herkunft__text p:nth-child(2) {
    grid-column: 5 / 9;
  }
  .herkunft__text :global(.link-arrow) {
    grid-column: 5 / 9;
    justify-self: start;
    color: var(--ink);
  }
  /* Bildunterschrift hängt unter dem Bild, ohne die gemeinsame Unterkante von Bild und Satz zu verschieben */
  .herkunft__bild :global(figcaption) {
    position: absolute;
    top: 100%;
    left: 0;
  }

  /* Entwurf 3: Tafel über die ganze Rasterbreite; die Legende steht in Spalten unter den Tellern
     (Spaltenkanten = Tellerkanten im Foto, von links: Rand 6,4 %, Teller 23,6 %, 2,3 %, 28,9 %, 2 %, 14,4 %, 2 %, 13,2 %) */
  .tafel {
    margin-inline: var(--m);
  }
  .tafel__bild :global(img) {
    width: 100%;
    aspect-ratio: 2560 / 1060;
    max-height: var(--werk-max);
    object-fit: cover;
  }
  .tafel__legende {
    margin: 0;
  }
  .tafel__legende ol {
    display: grid;
    grid-template-columns: 6.4fr 23.6fr 2.3fr 28.9fr 2fr 14.4fr 2fr 13.2fr 7.2fr;
    padding-top: 16px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 20px;
  }
  .tafel__legende li {
    display: grid;
    align-content: start;
    gap: 2px;
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
    hyphens: manual;
  }
  .tafel__legende li:nth-child(1) {
    grid-column: 2;
  }
  .tafel__legende li:nth-child(2) {
    grid-column: 4;
  }
  .tafel__legende li:nth-child(3) {
    grid-column: 6;
  }
  .tafel__legende li:nth-child(4) {
    grid-column: 8 / 10;
  }
  .tafel__nr {
    font-family: var(--f-display);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
    color: var(--ink);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .tafel__name {
    color: var(--ink);
  }
  .tafel__fuss {
    align-items: baseline;
    row-gap: 20px;
    padding-top: var(--head-gap);
  }
  .tafel__satz {
    grid-column: 1 / 9;
    max-width: 30ch;
    margin: 0;
    font-family: var(--f-text);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
    text-wrap: pretty;
  }
  .tafel__fuss :global(.link-arrow) {
    grid-column: 9 / 13;
    justify-self: start;
  }

  @media (max-width: 900px) {
    .satz__bild,
    .satz__nachweis,
    .satz__liste,
    .herkunft__titel,
    .herkunft__bild,
    .herkunft__text p:nth-child(1),
    .herkunft__text p:nth-child(2),
    .herkunft__text :global(.link-arrow),
    .tafel__satz,
    .tafel__fuss :global(.link-arrow) {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .satz__liste {
      margin-top: var(--head-gap);
      gap: 0;
    }
    .satz__liste li + li {
      padding-top: 14px;
    }
    .satz__liste li:not(:last-child) {
      padding-bottom: 14px;
    }
    .herkunft__bild :global(figcaption) {
      position: static;
    }
    .satz__nachweis {
      order: 1;
    }
    .satz__liste {
      order: 2;
    }
    .tafel__nr {
      font-size: var(--t-small);
      line-height: var(--t-small-lh);
    }
  }
</style>
