---
// Bauhaus-Station der Startseite in drei Entwürfen (Vorschau): ?bauhaus=2|3 wählt einen zum Vergleich, sonst gilt 4.
// Das Kopf-Skript in BaseLayout.astro setzt data-bauhaus an <html>, bevor die Seite zeichnet (kein Sprung).
// Nach der Entscheidung bleibt nur der gewählte Entwurf, Umschalter und die beiden anderen entfallen.
import Bild from './Bild.astro';
import Figure from './Figure.astro';
import LinkArrow from './LinkArrow.astro';
import SectionHead from './SectionHead.astro';
import TellerTafel from './TellerTafel.astro';
---

<div class="bauhaus" id="bauhaus">
  {/* Entwurf 4 (Standard): Herkunft und Gebrauch – die Jahreszahl als Marke über der Tafel mit vier Tellern */}
  <section class="entwurf entwurf--4" aria-labelledby="bauhaus-4-titel">
    <div class="kombi grid">
      <h2 class="kombi__titel" id="bauhaus-4-titel">
        <span class="kombi__jahr" data-reveal="fade">
          1927
        </span>
        <span class="kombi__satz" data-reveal="fade">
          In der Tradition des Bauhauses.
        </span>
      </h2>
      <p class="kombi__text" data-reveal="fade">
        Johannes Leßmann, Schüler des Bauhaus-Keramikers Otto Lindig, stellt die Werkstatt auf Serienkeramik um – bei
        strenger Einhaltung der Formgebungsprinzipien des Bauhauses.
      </p>
    </div>
    <TellerTafel />
    <div class="tafel-fuss grid">
      <p class="tafel-fuss__satz" data-reveal="fade">
        Jedes Stück muss gut zu drehen sein und auch zu benutzen.
      </p>
      <LinkArrow href="/manufaktur">Zum Manufakturprogramm</LinkArrow>
    </div>
  </section>

  {/* Entwurf 2: Herkunft – die Jahreszahl als Marke neben dem Regal mit Serienware, darunter ein Satz zur Herkunft */}
  <section class="entwurf entwurf--2" aria-labelledby="bauhaus-2-titel">
    <div class="herkunft grid">
      <h2 class="herkunft__titel" id="bauhaus-2-titel">
        <span class="herkunft__jahr" data-reveal="fade">
          1927
        </span>
        <span class="herkunft__satz" data-reveal="fade">
          In der Tradition des Bauhauses.
        </span>
      </h2>
      <Figure
        class="herkunft__bild"
        einblendung={false}
        unterschrift="Serienware vor dem ersten Brand · Foto: Haydar Koyupinar"
      >
        <div data-reveal="img">
          <Bild
            src="/img/kwm/regal.webp"
            width="954"
            height="905"
            loading="lazy"
            sizes="(min-width: 900px) 34vw, 100vw"
            alt="Regal voller ungebrannter Tassen, Schalen, Teller und Krüge aus dem Manufakturprogramm"
          />
        </div>
      </Figure>
      <div class="herkunft__text">
        <p data-reveal="fade">
          Johannes Leßmann, Schüler des Bauhaus-Keramikers Otto Lindig, stellt die Werkstatt auf Serienkeramik um – bei
          strenger Einhaltung der Formgebungsprinzipien des Bauhauses.
        </p>
        <p data-reveal="fade">
          1986 nehmen Young-Jae Lee und Hildegard Eggemann das Manufakturprogramm wieder auf. Den Blindstempel der
          Werkstatt tragen die Stücke seit 1930.
        </p>
        <LinkArrow href="/werkstatt#chronik">Zur Chronik</LinkArrow>
      </div>
    </div>
  </section>

  {/* Entwurf 3: Form folgt Gebrauch – eine Tafel wie im Musterkatalog: vier Teller, darunter Nummer, Name und Maß */}
  <section class="entwurf entwurf--3" aria-labelledby="bauhaus-3-titel">
    <SectionHead typ="start" titelId="bauhaus-3-titel">
      <Fragment slot="titel">Seit 1927 in der Tradition des Bauhauses.</Fragment>
      <p data-reveal="fade">Jedes Stück muss gut zu drehen sein und auch zu benutzen.</p>
    </SectionHead>
    <TellerTafel />
    <div class="tafel-fuss grid">
      <p class="tafel-fuss__satz" data-reveal="fade">
        Alle Teile eines Geschirrs, gleich welcher Farbe, sollten miteinander kombinierbar sein.
      </p>
      <LinkArrow href="/manufaktur">Zum Manufakturprogramm</LinkArrow>
    </div>
  </section>
</div>

<style>
  .bauhaus {
    padding-block: var(--section);
  }

  /* Umschaltung in der Vorschau: ohne Angabe Entwurf 4, ?bauhaus=2|3 zum Vergleich */
  .entwurf--2,
  .entwurf--3,
  :global(html[data-bauhaus='2']) .entwurf--4,
  :global(html[data-bauhaus='3']) .entwurf--4 {
    display: none;
  }
  :global(html[data-bauhaus='2']) .entwurf--2,
  :global(html[data-bauhaus='3']) .entwurf--3 {
    display: block;
  }

  /* Entwurf 4: Jahreszahl Spalte 1–7, Satz und Text Spalte 8–12 auf ihrer Grundlinie, Haarlinie, dann die Tafel */
  .kombi {
    align-items: end;
    row-gap: 20px;
    margin-inline: var(--m);
    padding: 0 0 20px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: var(--head-gap);
  }
  .kombi__titel {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: end;
    margin: 0;
    font-weight: 400;
  }
  .kombi__jahr {
    grid-column: 1 / 8;
    font-family: var(--f-display);
    font-size: var(--t-marke);
    line-height: var(--t-marke-lh);
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums;
    margin-left: -0.04em;
  }
  .kombi__satz {
    grid-column: 8 / 13;
    font-family: var(--f-display);
    font-size: var(--t-statement);
    line-height: var(--t-statement-lh);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .kombi__text {
    grid-column: 8 / 13;
    max-width: 44ch;
    margin: 0;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink-2);
  }
  /* Fuß unter der Tafel (Entwurf 3 und 4): Satz links, Link rechts */
  .tafel-fuss {
    align-items: baseline;
    row-gap: 20px;
    padding-top: var(--head-gap);
  }
  .tafel-fuss__satz {
    grid-column: 1 / 9;
    max-width: 30ch;
    margin: 0;
    font-family: var(--f-text);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
    text-wrap: pretty;
  }
  .tafel-fuss :global(.link-arrow) {
    grid-column: 9 / 13;
    justify-self: start;
  }

  /* Entwurf 2: Jahreszahl als Marke (Spalte 1–8) und Regal (9–12) auf einer Unterkante, darunter Text im selben Raster */
  .herkunft {
    align-items: end;
    row-gap: var(--head-gap);
  }
  .herkunft__titel {
    grid-column: 1 / 9;
    margin: 0;
    font-weight: 400;
  }
  .herkunft__jahr {
    display: block;
    font-family: var(--f-display);
    font-size: var(--t-marke);
    line-height: var(--t-marke-lh);
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums;
    margin-left: -0.04em;
  }
  .herkunft__satz {
    display: block;
    margin-top: 24px;
    font-family: var(--f-display);
    font-size: var(--t-statement);
    line-height: var(--t-statement-lh);
    letter-spacing: -0.02em;
  }
  .herkunft__bild {
    grid-column: 9 / 13;
    position: relative;
  }
  .herkunft__bild :global(img) {
    width: 100%;
    aspect-ratio: 954 / 905;
    max-height: var(--werk-max);
    object-fit: cover;
  }
  .herkunft__text {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    row-gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink-2);
  }
  .herkunft__text p {
    max-width: 44ch;
    margin: 0;
  }
  .herkunft__text p:nth-child(1) {
    grid-column: 1 / 5;
  }
  .herkunft__text p:nth-child(2) {
    grid-column: 5 / 9;
  }
  .herkunft__text :global(.link-arrow) {
    grid-column: 9 / 13;
    grid-row: 1;
    justify-self: start;
    color: var(--ink);
  }
  /* Bildunterschrift hängt unter dem Bild, ohne die gemeinsame Unterkante von Bild und Satz zu verschieben */
  .herkunft__bild :global(figcaption) {
    position: absolute;
    top: 100%;
    left: 0;
  }

  @media (max-width: 900px) {
    .kombi__jahr,
    .kombi__satz,
    .kombi__text,
    .herkunft__titel,
    .herkunft__bild,
    .herkunft__text p:nth-child(1),
    .herkunft__text p:nth-child(2),
    .herkunft__text :global(.link-arrow),
    .tafel-fuss__satz,
    .tafel-fuss :global(.link-arrow) {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .kombi__titel {
      row-gap: 16px;
    }
    .herkunft__bild :global(figcaption) {
      position: static;
    }
  }
</style>
