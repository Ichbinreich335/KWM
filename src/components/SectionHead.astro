---
interface Props {
  /** `start`: Abschnittskopf der Startseite mit Begleittext oder Link; `kapitel`: Kapitelkopf der Unterseiten mit Einleitung */
  typ?: 'start' | 'kapitel';
  /** Id der Überschrift, auf die `aria-labelledby` des Abschnitts zeigt */
  titelId: string;
  /** Zusätzliche Klasse für den rechten Teil (nur Typ `start`) */
  rechtsKlasse?: string | undefined;
}

const { typ = 'kapitel', titelId, rechtsKlasse } = Astro.props;
const hatRechts = Astro.slots.has('default');
---

<div class:list={[typ === 'start' ? 'sec-head' : 'chapter__head', 'grid']}>
  <h2 class="h2" id={titelId} data-reveal="words">
    <slot name="titel" />
  </h2>
  {hatRechts &&
    (typ === 'start' ? (
      <div class:list={['sec-head__aside', rechtsKlasse]}>
        <slot />
      </div>
    ) : (
      <p class="chapter__intro" data-reveal="fade">
        <slot />
      </p>
    ))}
</div>

<style>
  /* Gemeinsamer Abschnittskopf: H2 Spalte 1–8, Begleittext Spalte 9–12, unten bündig, Haarlinie */
  .sec-head {
    align-items: end;
    row-gap: 20px;
    margin-inline: var(--m);
    padding: 0 0 20px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: var(--head-gap);
  }
  .sec-head .h2 {
    grid-column: 1 / 9;
  }
  .sec-head__aside {
    grid-column: 9 / 13;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink-2);
  }
  .sec-head__aside :global(p) {
    max-width: 44ch;
    margin: 0;
  }
  .sec-head__aside :global(p + p) {
    margin-top: 20px;
  }
  .sec-head__aside :global(.link-arrow) {
    margin: 0;
    color: var(--ink);
  }
  .sec-head__aside :global(p + .link-arrow) {
    margin-top: 8px;
  }

  /* Kapitel: wie .sec-head der Startseite. Überschrift links (1–8), Begleittext rechts (9–12), unten bündig, Haarlinie darunter, dann --head-gap */
  .chapter__head {
    margin-inline: var(--m);
    padding: 0 0 20px;
    row-gap: 20px;
    align-items: end;
    border-bottom: 1px solid currentColor;
    margin-bottom: var(--head-gap);
  }
  .chapter__head .h2 {
    grid-column: 1 / 9;
  }
  .chapter__intro {
    grid-column: 9 / 13;
    margin: 0;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink-2);
    max-width: 44ch;
  }

  @media (max-width: 900px) {
    .sec-head .h2,
    .sec-head__aside,
    .chapter__head .h2,
    .chapter__intro {
      grid-column: 1 / -1;
    }
  }
</style>
