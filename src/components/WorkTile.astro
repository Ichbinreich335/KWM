---
import type { Werk } from '../data/werke';
import { angabeText } from '../data/werke';
import Bild from './Bild.astro';

interface Props {
  /** Kachel der Werkschau mit Jahr, ganz als Link zum Katalog; steht in einer `ol`, daher `li` */
  werk: Werk;
}

const { werk } = Astro.props;
---

<li class="piece">
  <a href={werk.verweis}>
    <span class="piece__media">
      <Bild src={werk.bild.src} width={werk.bild.breite} height={werk.bild.hoehe} loading="lazy" alt={werk.bild.alt} />
    </span>
    <span class="piece__head">
      <span class="piece__name">{werk.titel}</span>
      <span class="piece__year">{werk.jahr}</span>
    </span>
    {werk.angaben.map((angabe) => (
      <span class="piece__spec">{angabeText(angabe)}</span>
    ))}
  </a>
</li>

<style>
  /* Platzierung im Seitenraster: global.css (.works__grid) */
  .piece a {
    display: block;
    text-decoration: none;
  }
  .piece__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--ground-2);
    overflow: hidden;
  }
  .piece__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-zoom) var(--ease);
  }
  .piece a:hover .piece__media :global(img) {
    transform: scale(1.04);
  }
  .piece__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }
  .piece__name {
    font-family: var(--f-display);
    font-size: var(--t-quote);
    line-height: var(--t-quote-lh);
  }
  .piece__year {
    flex: none;
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .piece__spec {
    display: block;
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
    margin-top: 4px;
  }
  .piece__spec + .piece__spec {
    margin-top: 0;
  }

  /* Handy: vier Werke mit Titel und Jahr; Angaben und die übrigen Werke stehen auf /meisterstuecke */
  @media (max-width: 900px) {
    .piece:nth-child(n + 5),
    .piece__spec {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .piece__head {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
