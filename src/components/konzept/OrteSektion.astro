---
import Bild from '../Bild.astro';
---

    {/* Orte: Ausstellungsorte im Bildraster (src/scripts/sig-orte.ts) */}
    <section class="orte" id="orte" data-sig="orte" aria-labelledby="orte-title">
      <div class="orte__head grid">
        <h2 class="h2" id="orte-title" data-reveal="words">
          Ausstellungsorte
        </h2>
        <div class="orte__aside">
          <p data-reveal="fade">Ausstellungen seit 1980 in Europa, Korea, Japan und den USA.</p>
          <a class="link-arrow" href="/young-jae-lee#ausstellungen">
            Alle Ausstellungen
          </a>
          <slot />
        </div>
      </div>
      {/* Absatz bleibt einzeilig: Umbrüche von Prettier setzen sonst ein Leerzeichen zwischen die Inline-Elemente */}
      {/* prettier-ignore */}
      <p class="orte__tip" data-orte-tip>Auf eine Stadt <span class="orte__tip-fine">klicken</span><span class="orte__tip-coarse">tippen</span>, um die Ausstellungen dort zu sehen.</p>
