---
import type { Ausstellung } from '../data/ausstellungen';
import type { Hinweis } from '../data/hinweise';
import ExhibitionCard from './ExhibitionCard.astro';
import LinkArrow from './LinkArrow.astro';

interface Props {
  /** Laufende und kommende Ausstellungen; die mit `spotlight` steht groß und offen */
  ausstellungen: readonly Ausstellung[];
  /** Hinweiszeilen; ob sie sichtbar sind, entscheidet der Browser nach `von` und `bis` */
  hinweise: readonly Hinweis[];
}

const { ausstellungen, hinweise } = Astro.props;
const spotlights = ausstellungen.filter((eintrag) => eintrag.spotlight);
const weitere = ausstellungen.filter((eintrag) => !eintrag.spotlight);
---

{/* Dunkler Abschnitt der Startseite; das Skript setzt Status und Hinweise nach dem Datum und lässt immer nur ein Detail offen (sig-aktuell.ts) */}
<kwm-aktuell>
  <section class="aktuell on-anker" id="aktuelles" aria-labelledby="aktuell-title">
    <div class="aktuell__head grid">
      <h2 class="h2" id="aktuell-title" data-reveal="words">
        Aktuell
      </h2>
      <LinkArrow class="aktuell__all" href="/aktuelles">
        Alle Ausstellungen und Termine
      </LinkArrow>
    </div>

    {hinweise.map((hinweis) => (
      <p class="aktuell__note" data-start={hinweis.von} data-end={hinweis.bis}>
        {hinweis.text}
      </p>
    ))}

    <ol class="aktuell__list">
      {spotlights.map((eintrag) => (
        <ExhibitionCard typ="spotlight" ausstellung={eintrag} />
      ))}
      <li class="aktuell__rest">
        <p class="aktuell__hint" aria-hidden="true">
          Wischen
        </p>
        <ol class="aktuell__reihe" aria-label="Weitere Ausstellungen" tabindex="0">
          {weitere.map((eintrag) => (
            <ExhibitionCard typ="kachel" ausstellung={eintrag} />
          ))}
        </ol>
      </li>
    </ol>
  </section>
</kwm-aktuell>

<script>
  // Aktuell: Status je Ausstellung aus dem Datum, Details klappen auf (Modul sig-aktuell)
  import init from '../scripts/sig-aktuell';

  class KwmAktuell extends HTMLElement {
    connectedCallback() {
      const abschnitt = this.querySelector('.aktuell');
      if (abschnitt) init(abschnitt);
    }
  }

  if (!customElements.get('kwm-aktuell')) customElements.define('kwm-aktuell', KwmAktuell);
</script>

<style is:global>
  /* Hülle für das Skript, ohne eigenen Kasten */
  kwm-aktuell {
    display: contents;
  }

  /* Signatur: aktuell. Anker (dunkel): laufende und kommende Ausstellungen mit Foto, Details klappen darunter auf. */
  .aktuell {
    padding-block: var(--section);
    --aktuell-reihe: clamp(48px, 6vw, 88px); /* Abstand zwischen den Reihen der Liste */
    --aktuell-karte: min(80vw, 420px); /* Breite einer Karte in der Wischreihe (Handy) */
  }
  .aktuell ::selection {
    background: var(--on-coal);
    color: var(--coal);
  }

  .aktuell__head {
    align-items: end;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--on-coal);
    margin-inline: var(--m);
    padding-inline: 0;
    margin-bottom: var(--head-gap);
  }
  .aktuell__head .h2 {
    grid-column: 1 / 9;
  }
  .aktuell__all {
    grid-column: 9 / 13;
    justify-self: start;
  }

  .aktuell__list {
    list-style: none;
    margin: 0;
    padding: 0 var(--m);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--g);
    row-gap: 0;
    align-items: start;
  }
  .aktuell__item {
    grid-column: span 4;
  }
  .aktuell__item[data-spotlight] {
    grid-column: 1 / -1;
  }
  /* Die weiteren Karten stehen in einer eigenen Liste; am Desktop löst display: contents sie wieder ins Raster auf */
  .aktuell__rest,
  .aktuell__reihe {
    display: contents;
    list-style: none;
  }
  .aktuell__hint {
    display: none;
  }
  .aktuell__note {
    margin: 0 var(--m) var(--head-gap);
    padding-left: 16px;
    border-left: 2px solid var(--accent-on-coal);
    font-size: var(--t-body);
    line-height: var(--t-body-lh);
    color: var(--on-coal);
    max-width: 68ch;
    text-wrap: pretty;
  }
  .aktuell__note[hidden] {
    display: none;
  }
  .aktuell__head:has(+ .aktuell__note:not([hidden])) {
    margin-bottom: 28px;
  }
  @media (max-width: 900px) {
    .aktuell__item,
    .aktuell__item[data-spotlight] {
      grid-column: 1 / -1;
    }
    .aktuell__head .h2 {
      grid-column: 1 / -1;
    }
    .aktuell__all {
      grid-column: 1 / -1;
      justify-self: start;
      margin-top: 16px;
    }
    .aktuell__note {
      font-size: var(--t-small);
      line-height: var(--t-small-lh);
    }
    /* Weitere Karten als Wischreihe (Muster der Chronik): die Karte ist rund 80 % breit, die nächste schaut heraus */
    .aktuell__rest {
      display: block;
      grid-column: 1 / -1;
    }
    .aktuell__hint {
      display: block;
      margin: 0 0 16px;
      font-size: var(--t-meta);
      line-height: var(--t-meta-lh);
      letter-spacing: 0.04em;
      color: var(--on-coal-2);
    }
    .aktuell__hint::after {
      content: ' \2192';
      font-family: system-ui, sans-serif;
    }
    .aktuell__reihe {
      display: flex;
      align-items: flex-start;
      gap: var(--g);
      margin-inline: calc(var(--m) * -1);
      padding-inline: var(--m);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--m);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .aktuell__reihe::-webkit-scrollbar {
      display: none;
    }
    .aktuell__reihe:focus-visible {
      outline: var(--focus-ring) solid var(--on-coal);
      outline-offset: -2px;
    }
    /* In der schmalen Karte steht die Bezeichnung über dem Wert, sonst stößt „Öffnungszeiten“ an */
    .aktuell__reihe .aktuell__facts > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2px;
    }
    .aktuell__reihe > .aktuell__item {
      flex: 0 0 var(--aktuell-karte);
      margin-bottom: 0;
      scroll-snap-align: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aktuell {
      --dur-open: 0s;
    }
  }
</style>
