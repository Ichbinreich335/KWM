---
import type { Ausstellung } from '../data/ausstellungen';
import type { Hinweis } from '../data/hinweise';
import ExhibitionCard from './ExhibitionCard.astro';
import LinkArrow from './LinkArrow.astro';

interface Props {
  /** Laufende und kommende Ausstellungen; die mit `spotlight` steht groß und offen */
  ausstellungen: readonly Ausstellung[];
  /** Hinweiszeilen; ob sie sichtbar sind, entscheidet der Browser nach `von` und `bis` */
  hinweise: readonly Hinweis[];
}

const { ausstellungen, hinweise } = Astro.props;
---

{/* Dunkler Abschnitt der Startseite; das Skript setzt Status und Hinweise nach dem Datum und lässt immer nur ein Detail offen (sig-aktuell.ts) */}
<section class="aktuell" id="aktuelles" data-sig="aktuell" aria-labelledby="aktuell-title">
  <div class="aktuell__head grid">
    <h2 class="h2" id="aktuell-title" data-reveal="words">
      Aktuell
    </h2>
    <LinkArrow class="aktuell__all" href="/aktuelles">
      Alle Ausstellungen und Termine
    </LinkArrow>
  </div>

  {hinweise.map((hinweis) => (
    <p class="aktuell__note" data-start={hinweis.von} data-end={hinweis.bis}>
      {hinweis.text}
    </p>
  ))}

  <ol class="aktuell__list">
    {ausstellungen.map((eintrag) => (
      <ExhibitionCard typ={eintrag.spotlight ? 'spotlight' : 'kachel'} ausstellung={eintrag} />
    ))}
  </ol>
</section>

<style is:global>
  /* Signatur: aktuell. Anker (dunkel): laufende und kommende Ausstellungen mit Foto, Details klappen darunter auf. */
  .aktuell {
    background: var(--coal);
    color: var(--on-coal);
    padding-block: var(--section);
    --ink-2: var(--on-coal-2);
    --hair: rgba(236, 234, 227, 0.22);
    --cover: var(--coal);
    --aktuell-ease-time: 0.5s;
    --aktuell-reihe: clamp(48px, 6vw, 88px); /* Abstand zwischen den Reihen der Liste */
  }
  .aktuell ::selection {
    background: var(--on-coal);
    color: var(--coal);
  }

  .aktuell__head {
    align-items: end;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--on-coal);
    margin-inline: var(--m);
    padding-inline: 0;
    margin-bottom: var(--head-gap);
  }
  .aktuell__head .h2 {
    grid-column: 1 / 9;
  }
  .aktuell__all {
    grid-column: 9 / 13;
    justify-self: start;
  }

  .aktuell__list {
    list-style: none;
    margin: 0;
    padding: 0 var(--m);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--g);
    row-gap: 0;
    align-items: start;
  }
  .aktuell__item {
    grid-column: span 4;
  }
  .aktuell__item[data-spotlight] {
    grid-column: 1 / -1;
  }
  .aktuell__note {
    margin: 0 var(--m) var(--head-gap);
    padding-left: 16px;
    border-left: 2px solid var(--accent-on-coal);
    font-size: var(--t-body);
    line-height: var(--t-body-lh);
    color: var(--on-coal);
    max-width: 68ch;
    text-wrap: pretty;
  }
  .aktuell__note[hidden] {
    display: none;
  }
  .aktuell__head:has(+ .aktuell__note:not([hidden])) {
    margin-bottom: 28px;
  }
  @media (max-width: 900px) {
    .aktuell__item,
    .aktuell__item[data-spotlight] {
      grid-column: 1 / -1;
    }
    .aktuell__head .h2 {
      grid-column: 1 / -1;
    }
    .aktuell__all {
      grid-column: 1 / -1;
      justify-self: start;
      margin-top: 16px;
    }
    .aktuell__note {
      font-size: var(--t-small);
      line-height: var(--t-small-lh);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aktuell {
      --aktuell-ease-time: 0s;
    }
  }
</style>
