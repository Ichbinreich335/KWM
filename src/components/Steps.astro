---
import type { Schritt } from '../data/typen';

type Props =
  | {
      /** Arbeitsschritte mit Bild links, das beim Scrollen stehen bleibt; Slot `bild` trägt das Bild */
      typ: 'arbeitsschritte';
      schritte: readonly Schritt[];
      /** Bildunterschrift unter dem Bild im Slot `bild` */
      bildunterschrift: string;
    }
  | {
      /** Nummerierte Wegbeschreibung, ein Satz je Schritt */
      typ: 'folge';
      schritte: readonly string[];
    };

const props = Astro.props;
---

{props.typ === 'arbeitsschritte' ? (
  <div class="steps grid">
    <figure class="steps__media">
      <div data-reveal="img">
        <slot name="bild" />
      </div>
      <figcaption>{props.bildunterschrift}</figcaption>
    </figure>
    <dl class="steps__list">
      {props.schritte.map((schritt) => (
        <div class="steps__item" data-reveal="fade">
          <dt>{schritt.titel}</dt>
          <dd>{schritt.text}</dd>
        </div>
      ))}
    </dl>
  </div>
) : (
  <ol class="route__steps">
    {props.schritte.map((schritt) => (
      <li>{schritt}</li>
    ))}
  </ol>
)}

<style>
  /* Arbeitsweise: Teeschale bleibt stehen, der Text zieht vorbei */
  .steps {
    align-items: start;
    row-gap: 48px;
  }
  .steps__media {
    grid-column: 1 / 6;
    position: sticky;
    top: calc(var(--head) + 72px);
  }
  .steps__media :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .steps__list {
    grid-column: 7 / 13;
    border-top: 1px solid var(--ink);
  }
  .steps__item {
    padding: 22px 0 20px;
    border-bottom: 1px solid var(--hair);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 8px var(--g);
  }
  .steps__item dt {
    font-family: var(--f-display);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
  }
  .steps__item dd {
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
  }

  /* Wegbeschreibung */
  .route__steps {
    counter-reset: step;
  }
  .route__steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.8em 1fr;
    gap: 6px;
    padding: 11px 0;
    border-bottom: 1px solid var(--hair);
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
  }
  .route__steps li::before {
    content: counter(step);
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
    padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .steps__media {
      grid-column: 1 / -1;
      position: static;
    }
    .steps__list {
      grid-column: 1 / -1;
    }
    .steps__item {
      grid-template-columns: 1fr;
    }
  }
</style>
