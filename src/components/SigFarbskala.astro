---
import type { Glasur } from '../data/glasuren';
import Bild from './Bild.astro';

interface Props {
  /** Probekacheln in der Reihenfolge der Skala (`glasuren` aus `glasuren.ts`) */
  glasuren: readonly Glasur[];
}

const { glasuren } = Astro.props;
---

{/* Grund- und Schriftfarbe jeder Kachel stehen als Klasse `scale__band--<schluessel>` im Stil unten (Test: glasuren.test.ts) */}
<div
  class="scale"
  role="group"
  aria-label="Die sechstonige Farbskala des Geschirrs: Glasurproben, antippen zum Vergrößern"
  data-sig="farbskala"
>
  {glasuren.map((glasur) => (
    <button
      type="button"
      class={`scale__band scale__band--${glasur.schluessel}`}
      aria-pressed="false"
      data-grund={glasur.farbe.grund}
      data-dunkel={glasur.farbe.dunkel}
      data-hell={glasur.farbe.hell}
      data-finish={glasur.oberflaeche}
      data-speckle={glasur.sprenkel}
      data-speckle-kind={glasur.sprenkelart}
      data-schichten={glasur.schichten ? '' : undefined}
      data-seed={glasur.seed}
    >
      <Bild class="scale__sample" src={glasur.probenbild} alt="" loading="lazy" />
      <span class="scale__label">
        <span class="scale__title">{glasur.name}</span>
        {glasur.zusatz && <span class="scale__meta">{glasur.zusatz}</span>}
      </span>
    </button>
  ))}
</div>

<style is:global>
  /* Signatur: farbskala */

  /* Farbskala: Glasur-Testkacheln. Ohne Skript bleiben es Flächen in der gemessenen Grundfarbe. */
  .scale {
    display: flex;
    gap: var(--g);
    height: clamp(400px, 68svh, 720px);
    padding-inline: var(--m);
  }
  .scale__band {
    appearance: none;
    border: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    overflow: hidden;
    background: var(--c);
    color: var(--t);
    transition: flex-grow var(--dur-zoom) var(--ease);
  }
  .scale__band--weiss {
    --c: #e2ddcd;
    --t: #1b1815;
  }
  .scale__band--hellgruen-matt {
    --c: #cfe0d6;
    --t: #1b1815;
  }
  .scale__band--hellgruen-glanz {
    --c: #94ae9b;
    --t: #1b1815;
  }
  .scale__band--dunkelgruen-glanz {
    --c: #3f3b22;
    --t: #f4f1e8;
  }
  .scale__band--dunkelgruen-matt {
    --c: #44462e;
    --t: #f4f1e8;
  }
  .scale__band--rostbraun {
    --c: #8d590a;
    --t: #fffdf6;
  }
  .scale__band:focus-visible {
    outline: var(--focus-ring) solid var(--ink);
    outline-offset: var(--focus-offset);
  }
  .scale__cv {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    pointer-events: none;
  }

  .scale__sample {
    position: absolute;
    z-index: 1;
    left: var(--g);
    top: var(--g);
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    transform-origin: 0 0;
    transform: scale(0.58);
    box-shadow: 3px 4px 10px rgba(46, 35, 25, 0.3);
    transition: transform 1.1s var(--ease);
  }
  .scale__label {
    position: absolute;
    z-index: 1;
    left: var(--g);
    right: 8px;
    bottom: var(--g);
    display: grid;
    grid-template-rows: auto 1.2em;
    gap: 2px;
    line-height: 1.2;
    white-space: nowrap;
  }
  .scale__title {
    font-family: var(--f-display);
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    letter-spacing: 0.005em;
  }
  .scale__meta {
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    letter-spacing: 0.03em;
  }
  .is-live .scale__label {
    opacity: 0;
    transition: opacity var(--dur-move) var(--ease);
  }
  .is-live.is-ready .scale__label {
    opacity: 1;
  }

  .scale.is-live .scale__band,
  .scale.is-live:hover .scale__band,
  .scale.is-live .scale__band:hover {
    flex-grow: 1;
  }
  .scale.is-live.has-open .scale__band {
    flex-grow: 0.8;
  }
  .scale.is-live.has-open .scale__band.is-open {
    flex-grow: 2.6;
  }
  .scale .scale__band.is-open .scale__sample,
  .scale:not(.is-live) .scale__band:hover .scale__sample {
    width: 96px;
    height: 96px;
    transform: scale(1);
  }
  .scale:not(.is-live) .scale__band:hover {
    flex-grow: 2.6;
  }

  @media (max-width: 900px) {
    .scale {
      flex-direction: column;
      height: 580px;
    }
    .scale__band {
      min-height: 0;
    }
    .scale .scale__sample {
      left: 12px;
      right: auto;
      top: 50%;
      transform-origin: 0 50%;
      transform: translateY(-50%) scale(0.42);
    }
    .scale .scale__band.is-open .scale__sample,
    .scale:not(.is-live) .scale__band:hover .scale__sample {
      transform: translateY(-50%) scale(0.85);
    }
    .scale__label {
      left: auto;
      right: var(--g);
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
      text-align: right;
    }
    .scale__title {
      font-size: var(--t-body);
      line-height: var(--t-body-lh);
    }
    .scale__band {
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scale__band,
    .scale .scale__sample,
    .scale__label {
      transition: none;
    }
  }
</style>
