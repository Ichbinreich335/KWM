---
import { kontakt } from '../data/kontakt';
import LinkArrow from './LinkArrow.astro';
import { anfrageLink } from '../scripts/anfrage-link';

interface Props {
  text: string;
  /** Vorbelegung für das Feld „Stück“ im Anfrageformular */
  stueck?: string;
}
const { text, stueck } = Astro.props;
const href = anfrageLink(stueck);
const hatHinweis = Astro.slots.has('default');
---

<section class="anfrage-band on-flaeche grid" aria-label="Anfrage">
  <p class="anfrage-band__text" data-reveal="fade">
    {text}
  </p>
  <div class="anfrage-band__actions" data-reveal="fade">
    <a class="button" href={href}>
      Anfrage schreiben
    </a>
    <LinkArrow href={kontakt.telefonHref}>{kontakt.telefon}</LinkArrow>
  </div>
  {hatHinweis && (
    <p class="anfrage-band__hint" data-reveal="fade">
      <slot />
    </p>
  )}
</section>
