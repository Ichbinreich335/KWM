---
interface Eintrag {
  href: `#${string}`;
  text: string;
}

interface Props {
  /** Zugänglicher Name der Navigation, z. B. „Kapitel dieser Seite“ */
  beschriftung: string;
  eintraege: readonly Eintrag[];
}
const { beschriftung, eintraege } = Astro.props;
---

<nav class="subnav" aria-label={beschriftung}>
  {eintraege.map(({ href, text }) => (
    <a href={href}>{text}</a>
  ))}
</nav>

<style>
  /* Sprungmarken innerhalb einer Seite */
  .subnav {
    position: sticky;
    top: var(--head);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0 12px;
    height: var(--subnav);
    padding-inline: calc(var(--m) - 8px);
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--ground);
    border-bottom: 1px solid var(--hair);
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    white-space: nowrap;
    transition: top var(--dur-move) var(--ease);
  }
  .subnav::-webkit-scrollbar {
    display: none;
  }
  :global(.masthead.is-hidden ~ main) .subnav {
    top: 0;
  }
  /* Randausblendung zeigt, dass die Leiste seitlich weiterläuft (Attribut setzt main.ts) */
  .subnav[data-more='start'] {
    mask-image: linear-gradient(90deg, transparent, #000 40px);
  }
  .subnav[data-more='end'] {
    mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent);
  }
  .subnav[data-more='start end'] {
    mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent);
  }
  .subnav a {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 44px;
    padding-inline: 8px;
    text-decoration: none;
    color: var(--ink-2);
  }
  .subnav a:hover,
  .subnav a.is-current {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
</style>
