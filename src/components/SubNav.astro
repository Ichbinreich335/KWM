---
interface Eintrag {
  href: `#${string}`;
  text: string;
}

interface Props {
  /** Zugänglicher Name der Navigation, z. B. „Kapitel dieser Seite“ */
  beschriftung: string;
  eintraege: readonly Eintrag[];
}
const { beschriftung, eintraege } = Astro.props;
---

<kwm-sprungleiste>
  <nav class="subnav" aria-label={beschriftung}>
    {eintraege.map(({ href, text }) => (
      <a href={href}>{text}</a>
    ))}
  </nav>
</kwm-sprungleiste>

<script>
  // Sprungleiste: markiert den Abschnitt, der gerade gelesen wird, und holt seinen Eintrag in die Mitte der Leiste.
  // Läuft die Leiste seitlich weiter, blendet sie den Rand aus (data-more).
  import { reducedMotion } from '../scripts/keramik';

  class KwmSprungleiste extends HTMLElement {
    private abort: AbortController | null = null;
    private beobachter: IntersectionObserver | null = null;

    connectedCallback() {
      const subnav = this.querySelector<HTMLElement>('.subnav');
      if (!subnav) return;
      this.abort = new AbortController();
      const { signal } = this.abort;
      const reduced = reducedMotion();

      const fade = () => {
        const max = subnav.scrollWidth - subnav.clientWidth;
        const parts = [];
        if (max > 1 && subnav.scrollLeft > 1) parts.push('start');
        if (max > 1 && subnav.scrollLeft < max - 1) parts.push('end');
        subnav.dataset.more = parts.join(' ');
      };
      subnav.addEventListener('scroll', fade, { passive: true, signal });
      addEventListener('resize', fade, { passive: true, signal });
      fade();

      const subLinks = [...subnav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
      const byId = new Map(
        subLinks.map((a): [string, HTMLAnchorElement] => [(a.getAttribute('href') ?? '').slice(1), a]),
      );
      this.beobachter = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const current = e.isIntersecting && byId.get(e.target.id);
            if (!current) return;
            subLinks.forEach((a) => {
              a.classList.toggle('is-current', a === current);
              if (a === current) a.setAttribute('aria-current', 'true');
              else a.removeAttribute('aria-current');
            });
            const left = current.offsetLeft - (subnav.clientWidth - current.offsetWidth) / 2;
            subnav.scrollTo({ left, behavior: reduced ? 'auto' : 'smooth' });
          });
        },
        { rootMargin: '-35% 0px -60% 0px' },
      );
      byId.forEach((_, id) => {
        const ziel = document.getElementById(id);
        if (ziel) this.beobachter?.observe(ziel);
      });
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.beobachter?.disconnect();
    }
  }

  if (!customElements.get('kwm-sprungleiste')) customElements.define('kwm-sprungleiste', KwmSprungleiste);
</script>

<style>
  /* Hülle für das Skript, ohne eigenen Kasten: die Leiste klebt weiter am Seitenfluss (position: sticky) */
  kwm-sprungleiste {
    display: contents;
  }

  /* Sprungmarken innerhalb einer Seite */
  .subnav {
    position: sticky;
    top: var(--head);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0 12px;
    height: var(--subnav);
    padding-inline: calc(var(--m) - 8px);
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--ground);
    border-bottom: 1px solid var(--hair);
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    white-space: nowrap;
    transition: top var(--dur-move) var(--ease);
  }
  .subnav::-webkit-scrollbar {
    display: none;
  }
  :global(.masthead.is-hidden ~ main) .subnav {
    top: 0;
  }
  /* Randausblendung zeigt, dass die Leiste seitlich weiterläuft (data-more setzt das Skript oben) */
  .subnav[data-more='start'] {
    mask-image: linear-gradient(90deg, transparent, #000 40px);
  }
  .subnav[data-more='end'] {
    mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent);
  }
  .subnav[data-more='start end'] {
    mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent);
  }
  .subnav a {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 44px;
    padding-inline: 8px;
    text-decoration: none;
    color: var(--ink-2);
  }
  .subnav a:hover,
  .subnav a.is-current {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
</style>
