---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'alt' | 'width' | 'height'> {
  /** Pfad wie in den Seiten, z. B. `/img/kwm/kannen.webp` (liegt unter `src/assets/img/`). */
  src: string;
  alt: string;
  /** Eigengröße in Pixeln; bestimmt die Box wie das frühere `width`-Attribut. */
  width: number;
  height: number;
  layout?: 'constrained' | 'full-width';
}

const { src, layout = 'constrained', ...rest } = Astro.props;

const bilder = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/**/*.{webp,jpg,png}', { eager: true });
const bild = bilder[`/src/assets${src}`];
// fit="fill": wie das frühere <img> ohne object-fit; das Seitenverhältnis kommt aus width/height und CSS.
if (!bild) throw new Error(`Bild nicht gefunden: ${src}`);
---

<Image src={bild.default} layout={layout} fit="fill" {...rest} />
