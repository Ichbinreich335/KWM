---
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { bildMetadaten } from '../data/bilder';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'alt' | 'width' | 'height' | 'sizes'> & {
  /** Pfad wie in den Seiten, z. B. `/img/kwm/kannen.webp` (liegt unter `src/assets/img/`). */
  src: string;
  alt: string;
  /** Eigengröße in Pixeln; bestimmt die Box wie das frühere `width`-Attribut. */
  width: number | `${number}`;
  height: number | `${number}`;
  layout?: 'constrained' | 'full-width';
  /** Bild im ersten Bildschirm: setzt loading="eager", decoding="sync" und fetchpriority="high". */
  priority?: boolean;
} & (
    | {
        /** Breiten der srcset-Kandidaten, wenn die Quelle größer ist als die angezeigte Eigengröße. */
        widths: number[];
        /** Pflicht, sobald `widths` gesetzt ist (Doku). */
        sizes: string;
      }
    | { widths?: never; sizes?: string }
  );

const { src, layout = 'constrained', ...rest } = Astro.props;

// fit="fill": wie das frühere <img> ohne object-fit; das Seitenverhältnis kommt aus width/height und CSS.
---

<Image src={bildMetadaten(src)} layout={layout} fit="fill" {...rest} />
