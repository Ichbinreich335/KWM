---
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { bildMetadaten } from '../lib/bilder';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'alt' | 'width' | 'height' | 'sizes'> & {
  /** Pfad wie in den Seiten, z. B. `/img/kwm/kannen.webp` (liegt unter `src/assets/img/`). */
  src: string;
  alt: string;
  /** Eigengröße in Pixeln; ohne Angabe gelten die Maße des Bildes selbst (ImageMetadata). */
  width?: number | `${number}` | undefined;
  height?: number | `${number}` | undefined;
  layout?: 'constrained' | 'full-width';
  /** Bild im ersten Bildschirm: setzt loading="eager", decoding="sync" und fetchpriority="high". */
  priority?: boolean;
} & (
    | {
        /** Breiten der srcset-Kandidaten, wenn die Quelle größer ist als die angezeigte Eigengröße. */
        widths: number[];
        /** Pflicht, sobald `widths` gesetzt ist (Doku). */
        sizes: string;
      }
    | { widths?: never; sizes?: string }
  );

const { src, layout = 'constrained', width, height, ...rest } = Astro.props;
// Maße nur weitergeben, wenn sie angegeben sind; sonst nimmt Astro sie aus den ImageMetadata
const masse = { ...(width !== undefined && { width }), ...(height !== undefined && { height }) };

// fit="fill": kein Zuschnitt durch Astro; das Seitenverhältnis kommt aus den Maßen (angegeben oder aus dem Bild) und CSS.
---

<Image src={bildMetadaten(src)} layout={layout} fit="fill" {...masse} {...rest} />
