---
import { kontakt } from '../data/kontakt';
import Button from './Button.astro';
---

{/* Anfrage-Formular (wiederverwendbar, Modul sig-anfrage).
     Später: action="/api/anfrage" method="post" an einen Cloudflare-Worker mit Mail-Dienst und Turnstile.
     Bis dahin fängt das Modul das Absenden ab, prüft die Felder und öffnet eine vorbereitete E-Mail. */}
<div class="anfrage" data-sig="anfrage">
  <p class="anfrage__nojs">
    Bitte schreiben Sie uns an <a href={`${kontakt.mailHref}?subject=Anfrage`}>{kontakt.mail}</a> oder rufen Sie an:{' '}
    <a href={kontakt.telefonHref}>{kontakt.telefon}</a>.
  </p>
  <form class="anfrage__form" novalidate>
    <div class="anfrage__field">
      <label for="anfrage-name">Name</label>
      <input
        id="anfrage-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        aria-describedby="anfrage-name-fehler"
      />
      <p class="anfrage__error" id="anfrage-name-fehler" hidden></p>
    </div>
    <div class="anfrage__field">
      <label for="anfrage-email">E-Mail</label>
      <input
        id="anfrage-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
        aria-describedby="anfrage-email-fehler"
      />
      <p class="anfrage__error" id="anfrage-email-fehler" hidden></p>
    </div>
    <div class="anfrage__field">
      <label for="anfrage-telefon">
        Telefon <span>(freiwillig)</span>
      </label>
      <input
        id="anfrage-telefon"
        name="telefon"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        aria-describedby="anfrage-telefon-fehler"
      />
      <p class="anfrage__error" id="anfrage-telefon-fehler" hidden></p>
    </div>
    <div class="anfrage__field">
      <label for="anfrage-stueck">
        Anliegen oder Stück <span>(freiwillig)</span>
      </label>
      <input
        id="anfrage-stueck"
        name="stueck"
        type="text"
        autocomplete="off"
        maxlength="400"
        placeholder="z. B. Geschirr, Edition oder ein Meisterstück"
      />
    </div>
    <div class="anfrage__field">
      <label for="anfrage-nachricht">Nachricht</label>
      <textarea
        id="anfrage-nachricht"
        name="nachricht"
        rows="5"
        required
        aria-describedby="anfrage-nachricht-fehler"
      ></textarea>
      <p class="anfrage__error" id="anfrage-nachricht-fehler" hidden></p>
    </div>
    <p class="anfrage__privacy">
      Ihre Angaben verwenden wir nur, um Ihre Anfrage zu beantworten. Verantwortlich ist die Keramische Werkstatt
      Margaretenhöhe, siehe <a href="/datenschutz">Datenschutz</a>.
    </p>
    <div class="anfrage__submit">
      <Button type="submit">Anfrage senden</Button>
      <p class="anfrage__summary" role="alert" hidden></p>
    </div>
  </form>
  <div class="anfrage__done" role="status" tabindex="-1" hidden>
    <p class="anfrage__done-title">Danke, Ihre Anfrage ist vorbereitet.</p>
    <p>Ihr E-Mail-Programm öffnet sich mit der vorbereiteten Anfrage. Bitte senden Sie die Nachricht dort ab.</p>
    <p>
      Es öffnet sich nichts? Schreiben Sie an <a href={kontakt.mailHref}>{kontakt.mail}</a> oder rufen Sie an:{' '}
      <a href={kontakt.telefonHref}>{kontakt.telefon}</a>.
    </p>
    <button class="anfrage__again" type="button">
      Angaben ändern
    </button>
  </div>
</div>

<style is:global>
  /* Anfrage-Formular: Felder mit Unterstrich, 0 Radius, Labels über dem Feld */
  .anfrage {
    max-width: 560px;
  }
  .anfrage__nojs {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  .js .anfrage__nojs {
    display: none;
  }
  .anfrage__form {
    display: none;
  }
  .js .anfrage__form:not([hidden]) {
    display: grid;
    gap: 28px;
    padding-top: 4px;
  }

  .anfrage__field {
    display: grid;
    gap: 6px;
  }
  .anfrage label {
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .anfrage label span {
    letter-spacing: 0;
  }
  .anfrage input,
  .anfrage textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 0 9px;
    font: inherit;
    font-size: var(--t-body);
    line-height: var(--t-body-lh);
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .anfrage textarea {
    min-height: 140px;
    resize: vertical;
    line-height: 1.5;
  }
  .anfrage input::placeholder {
    color: var(--ink-2);
    opacity: 0.8;
  }
  .anfrage input:hover,
  .anfrage textarea:hover {
    background: var(--ground-2);
  }
  .anfrage input:focus-visible,
  .anfrage textarea:focus-visible {
    outline: 0;
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 var(--accent);
  }
  .anfrage [aria-invalid] {
    border-bottom-color: var(--ink);
    box-shadow: 0 1px 0 var(--ink);
  }
  .anfrage__error {
    margin: 0;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink);
  }
  .anfrage__error::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background: var(--ink);
  }

  .anfrage__privacy {
    margin: 0;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink-2);
  }
  .anfrage__privacy a,
  .anfrage__done a,
  .anfrage__nojs a {
    text-underline-offset: 0.2em;
  }
  .anfrage__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .anfrage .button {
    min-height: 48px;
    cursor: pointer;
    font-family: inherit;
  }
  .anfrage__summary {
    margin: 0;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
  }

  .anfrage__done {
    padding-top: 20px;
    border-top: 1px solid var(--ink);
  }
  .anfrage__done:focus {
    outline: 0;
  }
  .anfrage__done p {
    margin: 0 0 16px;
    max-width: 46ch;
  }
  .anfrage__done-title {
    font-family: var(--f-display);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
  }
  .anfrage__again {
    min-height: 44px;
    padding: 0;
    font: inherit;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    color: var(--ink);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  /* Einsatz im Abschnitt Besuch der Startseite: Öffnungszeiten links, Formular rechts */
  .visit__info {
    grid-column: 1 / 6;
  }
  .visit__info .visit__actions {
    margin-top: 28px;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .visit__form {
    grid-column: 7 / 13;
    scroll-margin-top: calc(var(--head) + 24px);
  }
  .inquiry {
    scroll-margin-top: var(--head);
  }
  @media (max-width: 900px) {
    .visit__info,
    .visit__form {
      grid-column: 1 / -1;
    }
  }
</style>
