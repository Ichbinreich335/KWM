---
interface Props {
  /** Bild mit Text darauf: `feuer` (Abschnitt zum Brand) */
  variante: 'feuer';
  /** Element der Hülle: `section` für einen eigenen Abschnitt, sonst `div` */
  als?: 'div' | 'section';
  id?: string;
  'aria-labelledby'?: string;
}

const { variante, als: Tag = 'div', ...rest } = Astro.props;
---

{/* Das Bild bleibt beim Scrollen stehen und der Text läuft darüber (sig-sticky.ts); ohne Skript stehen Bild und Text untereinander */}
<Tag class={`sticky-bild sticky-bild--${variante}`} data-sig="sticky" {...rest}>
  <div class="sticky-bild__media">
    <slot name="bild" />
  </div>
  <div class="sticky-bild__pane grid">
    <slot />
  </div>
</Tag>

<style is:global>
  /* Signatur: sticky – Text bleibt beim Scrollen oben im Foto stehen, bis das Bild durch ist (Feuer).
     Abschnitt ist höher als der Bildschirm, die Textebene ist nur so hoch wie der Text, klebt oben und zieht am Ende mit dem Abschnitt weiter.
     Das Foto läuft normal mit; src/scripts/sig-sticky.ts verschiebt es nur minimal gegenläufig (Parallax, ≤ 5 %). */
  .sticky-bild {
    --sticky-h: 150svh;
    --sticky-over-anteil: 0.06; /* Bild ragt oben und unten über, Platz für den Parallax */
    --sticky-over: calc(var(--sticky-over-anteil) * 100%);
    --sticky-shift: 0%; /* setzt sig-sticky.ts, Wertebereich ±5 % der Bildhöhe */
    --sticky-text-from: 1;
    --sticky-text-to: 9;
    position: relative;
    height: var(--sticky-h);
    overflow: clip;
    background: var(--coal);
    color: var(--on-coal);
    --ink-2: var(--on-coal-2);
    --cover: var(--coal);
  }
  .sticky-bild ::selection {
    background: var(--on-coal);
    color: var(--coal);
  }

  .sticky-bild__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .sticky-bild__img {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--sticky-over) * -1);
    width: 100%;
    height: calc(100% + var(--sticky-over) * 2);
    object-fit: cover;
    transform: translate3d(0, var(--sticky-shift), 0);
    will-change: transform;
  }
  /* Abdunklung: so viel wie für 4,5:1 nötig, stärker auf der Textseite, Foto bleibt rechts lesbar */
  .sticky-bild__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(10 10 10 / 0.78) 0%, rgb(10 10 10 / 0.6) 55%, rgb(10 10 10 / 0.2) 100%);
  }

  .sticky-bild__pane {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    align-content: center;
    pointer-events: none;
  }
  .sticky-bild__text {
    grid-column: var(--sticky-text-from) / var(--sticky-text-to);
    display: grid;
    gap: clamp(20px, 2.4vw, 36px);
    justify-items: start;
    pointer-events: auto;
  }
  .sticky-bild__lede {
    font-family: var(--f-text);
    font-size: var(--t-quote);
    line-height: var(--t-quote-lh);
    max-width: 40ch;
    margin: 0;
    text-wrap: pretty;
  }
  /* Feuer, Standard „haftend“: Der Text steht oben links im Bild fest (sticky), bis das Bild durch ist, und zieht dann mit.
     Haltestrecke = Abschnittshöhe minus Bildschirmhöhe. */
  .sticky-bild--feuer {
    --sticky-h: 160svh;
    --sticky-text-to: 8;
  }
  .sticky-bild--feuer .sticky-bild__pane {
    align-content: start;
    height: auto;
    padding-block: calc(var(--head) + var(--head-gap)) var(--head-gap);
    box-sizing: border-box;
  }
  .sticky-bild--feuer .sticky-bild__lede {
    max-width: 46ch;
  }
  .sticky-bild--feuer .sticky-bild__media::after {
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgb(10 10 10 / 0.78) 0%, rgb(10 10 10 / 0) 100%),
      linear-gradient(90deg, rgb(10 10 10 / 0.66) 0%, rgb(10 10 10 / 0.56) 58%, rgb(10 10 10 / 0.2) 100%);
  }

  @media (max-width: 900px) {
    .sticky-bild {
      --sticky-h: 130svh;
      --sticky-text-from: 1;
      --sticky-text-to: -1;
    }
    .sticky-bild--feuer {
      --sticky-h: 150svh;
      --sticky-text-to: -1;
    }
    .sticky-bild--feuer .sticky-bild__media::after {
      background: rgb(10 10 10 / 0.66);
    }
    .sticky-bild__media::after {
      background: rgb(10 10 10 / 0.66);
    }
    .sticky-bild__pane {
      align-content: end;
      padding-bottom: clamp(48px, 12svh, 96px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-bild__img {
      will-change: auto;
    }
  }
</style>
