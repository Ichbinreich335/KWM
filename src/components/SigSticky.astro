---
interface Props {
  /** Bild mit Text darauf: `feuer` (Abschnitt zum Brand) */
  variante: 'feuer';
  /** Element der Hülle: `section` für einen eigenen Abschnitt, sonst `div` */
  als?: 'div' | 'section';
  id?: string;
  'aria-labelledby'?: string;
}

const { variante, als: Tag = 'div', ...rest } = Astro.props;
---

{/* Der Text haftet oben im Bild (reines CSS), das Bild selbst bewegt sich nicht gegenläufig */}
<Tag class={`sticky-bild sticky-bild--${variante}`} {...rest}>
  <div class="sticky-bild__media">
    <slot name="bild" />
  </div>
  <div class="sticky-bild__pane grid">
    <slot />
  </div>
</Tag>

<style is:global>
  /* Signatur: sticky – Text bleibt beim Scrollen oben im Foto stehen, bis das Bild durch ist (Feuer).
     Abschnitt ist höher als der Bildschirm, die Textebene ist nur so hoch wie der Text, klebt oben und zieht am Ende mit dem Abschnitt weiter.
     Das Foto läuft normal mit und bleibt im Rahmen ruhig (kein Parallax). */
  .sticky-bild {
    --sticky-h: 150svh;
    --sticky-text-from: 1;
    --sticky-text-to: 9;
    position: relative;
    height: var(--sticky-h);
    overflow: clip;
    background: var(--coal);
    color: var(--on-coal);
    --ink-2: var(--on-coal-2);
    --cover: var(--coal);
  }
  .sticky-bild ::selection {
    background: var(--on-coal);
    color: var(--coal);
  }

  .sticky-bild__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .sticky-bild__img {
    position: absolute;
    inset-inline: 0;
    inset-block: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Abdunklung: so viel wie für 4,5:1 nötig, stärker auf der Textseite, Foto bleibt rechts lesbar */
  .sticky-bild__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(var(--shade) / 0.78) 0%,
      rgb(var(--shade) / 0.6) 55%,
      rgb(var(--shade) / 0.2) 100%
    );
  }

  .sticky-bild__pane {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    align-content: center;
    pointer-events: none;
  }
  .sticky-bild__text {
    grid-column: var(--sticky-text-from) / var(--sticky-text-to);
    display: grid;
    gap: clamp(20px, 2.4vw, 36px);
    justify-items: start;
    pointer-events: auto;
  }
  .sticky-bild__lede {
    font-family: var(--f-text);
    font-size: var(--t-quote);
    line-height: var(--t-quote-lh);
    max-width: 40ch;
    margin: 0;
    text-wrap: pretty;
  }
  /* Feuer, Standard „haftend“: Der Text steht oben links im Bild fest (sticky), bis das Bild durch ist, und zieht dann mit.
     Haltestrecke = Abschnittshöhe minus Bildschirmhöhe. */
  .sticky-bild--feuer {
    --sticky-h: 160svh;
    --sticky-text-to: 8;
  }
  .sticky-bild--feuer .sticky-bild__pane {
    align-content: start;
    height: auto;
    padding-block: calc(var(--head) + var(--head-gap)) var(--head-gap);
    box-sizing: border-box;
  }
  .sticky-bild--feuer .sticky-bild__lede {
    max-width: 46ch;
  }
  .sticky-bild--feuer .sticky-bild__media::after {
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, rgb(var(--shade) / 0.78) 0%, rgb(var(--shade) / 0) 100%),
      linear-gradient(90deg, rgb(var(--shade) / 0.66) 0%, rgb(var(--shade) / 0.56) 58%, rgb(var(--shade) / 0.2) 100%);
  }

  @media (max-width: 900px) {
    .sticky-bild {
      --sticky-h: 130svh;
      --sticky-text-from: 1;
      --sticky-text-to: -1;
    }
    .sticky-bild--feuer {
      --sticky-h: 150svh;
      --sticky-text-to: -1;
    }
    .sticky-bild--feuer .sticky-bild__media::after {
      background: rgb(var(--shade) / 0.66);
    }
    .sticky-bild__media::after {
      background: rgb(var(--shade) / 0.66);
    }
    .sticky-bild__pane {
      align-content: end;
      padding-bottom: clamp(48px, 12svh, 96px);
    }
  }
</style>
