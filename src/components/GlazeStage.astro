---
import { getImage } from 'astro:assets';
import { bildMetadaten } from '../data/bilder';
import { type Glasurprobe, type Probengruppe } from '../data/glasuren';
import Bild from './Bild.astro';

interface Props {
  /** Proben in der Reihenfolge der Knöpfe; die erste ist beim Laden gewählt */
  proben: readonly Glasurprobe[];
}

const { proben } = Astro.props;
const gruppen: readonly Probengruppe[] = ['Geschirr', 'Edition'];

// Die Knöpfe tragen die gebaute Bild-URL in data-img (Doku: Bild-URL an den Client reichen).
const probenbild = async (src: string) =>
  (
    await getImage({
      src: bildMetadaten(src),
      width: 100,
      height: 100,
      layout: 'constrained',
      fit: 'fill',
      position: 'center',
    })
  ).src;
const knoepfe = await Promise.all(proben.map(async (probe) => ({ ...probe, url: await probenbild(probe.probenbild) })));
const erste = knoepfe[0];
---

<kwm-glaze class="glaze grid">
  <div class="glaze__stage" data-glaze-stage aria-live="polite">
    <div class="glaze__layers" data-glaze-layers aria-hidden="true"></div>
    <div class="glaze__label">
      <p class="glaze__name" data-glaze-name>
        {erste?.name}
      </p>
      <p class="glaze__meta" data-glaze-meta>
        {erste?.meta}
      </p>
    </div>
  </div>
  <div class="glaze__pick">
    {gruppen.map((gruppe) => (
      <Fragment>
        <p class="glaze__group">{gruppe}</p>
        <ul class="glaze__list">
          {knoepfe
            .filter((probe) => probe.gruppe === gruppe)
            .map((probe) => (
              <li>
                <button
                  type="button"
                  class="glaze__btn"
                  aria-pressed={probe === erste ? 'true' : 'false'}
                  data-name={probe.name}
                  data-meta={probe.meta}
                  data-color={probe.farbe}
                  data-img={probe.url}
                  data-gloss={probe.glanz ? '' : undefined}
                  data-dark={probe.dunkel ? '' : undefined}
                >
                  <Bild src={probe.probenbild} width="100" height="100" alt="" loading="lazy" />
                  <span>{probe.name}</span>
                </button>
              </li>
            ))}
        </ul>
      </Fragment>
    ))}
  </div>
</kwm-glaze>

<script>
  // Glasurbühne: die Probe wird zur Fläche
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  class KwmGlaze extends HTMLElement {
    private current: HTMLButtonElement | null = null;
    private stage: Element | null = null;
    private layers: Element | null = null;
    private nameEl: Element | null = null;
    private metaEl: Element | null = null;
    private buttons: HTMLButtonElement[] = [];
    private pinned: HTMLButtonElement | undefined;

    connectedCallback() {
      this.stage = this.querySelector('[data-glaze-stage]');
      this.layers = this.querySelector('[data-glaze-layers]');
      this.nameEl = this.querySelector('[data-glaze-name]');
      this.metaEl = this.querySelector('[data-glaze-meta]');
      this.buttons = [...this.querySelectorAll<HTMLButtonElement>('.glaze__btn')];
      this.pinned = this.buttons[0];
      if (!this.stage || !this.layers || !this.nameEl || !this.metaEl || !this.pinned) return;
      this.buttons.forEach((btn) => {
        btn.addEventListener('pointerenter', (e) => {
          if (e.pointerType === 'mouse') this.show(btn);
        });
        btn.addEventListener('focus', () => this.select(btn));
        btn.addEventListener('click', () => {
          this.pinned = btn;
          this.select(btn);
        });
      });
      this.querySelector('.glaze__pick')?.addEventListener('pointerleave', () => this.pinned && this.show(this.pinned));
      this.select(this.pinned);
    }

    private show(btn: HTMLButtonElement) {
      if (btn === this.current || !this.stage || !this.layers || !this.nameEl || !this.metaEl) return;
      this.current = btn;
      const layer = document.createElement('div');
      layer.className = 'glaze__layer';
      layer.style.setProperty('--g', btn.dataset.color ?? '');
      layer.style.setProperty('--img', `url("${new URL(btn.dataset.img ?? '', location.href).href}")`);
      if ('gloss' in btn.dataset) layer.classList.add('is-gloss');
      this.layers.appendChild(layer);
      requestAnimationFrame(() => layer.classList.add('is-in'));
      const old = [...this.layers.children].slice(0, -1);
      setTimeout(() => old.forEach((l) => l.remove()), reduced ? 0 : 1200);
      this.stage.classList.toggle('is-dark', 'dark' in btn.dataset);
      this.nameEl.textContent = btn.dataset.name ?? '';
      this.metaEl.textContent = btn.dataset.meta ?? '';
    }

    private select(btn: HTMLButtonElement) {
      this.buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      this.show(btn);
    }
  }

  customElements.define('kwm-glaze', KwmGlaze);
</script>

<style>
  .glaze {
    align-items: stretch;
    row-gap: 40px;
  }
  .glaze__stage {
    grid-column: 1 / 8;
    position: relative;
    min-height: clamp(420px, 70vh, 720px);
    overflow: hidden;
    background: var(--ground-2);
    color: var(--ink);
    transition: color 0.8s var(--ease);
  }
  .glaze__stage.is-dark {
    color: var(--on-coal);
  }
  .glaze__layers,
  :global(.glaze__layer) {
    position: absolute;
    inset: 0;
  }
  :global(.glaze__layer) {
    background: var(--g);
    opacity: 0;
    transition: opacity 1.1s var(--ease);
  }
  :global(.glaze__layer.is-in) {
    opacity: 1;
  }
  /* Die echte Probe, stark vergrößert und weich: Tonflecken, Farbverlauf, Brandspuren */
  :global(.glaze__layer)::before {
    content: '';
    position: absolute;
    inset: -12%;
    background: var(--img) center / cover;
    filter: blur(28px) saturate(1.1);
    opacity: 0.85;
    transform: scale(1.06);
    transition: transform 6s var(--ease);
  }
  :global(.glaze__layer.is-in)::before {
    transform: scale(1);
  }
  /* Glanz: ein weiches Fensterlicht auf der Glasur */
  :global(.glaze__layer.is-gloss)::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 28% 22%, rgba(255, 255, 255, 0.34), transparent 70%),
      radial-gradient(30% 20% at 70% 78%, rgba(255, 255, 255, 0.12), transparent 70%);
    mix-blend-mode: screen;
  }
  .glaze__label {
    position: absolute;
    left: clamp(20px, 3vw, 40px);
    bottom: clamp(20px, 3vw, 40px);
    right: 20px;
  }
  .glaze__name {
    font-family: var(--f-display);
    font-size: var(--t-display);
    line-height: var(--t-display-lh);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .glaze__meta {
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    letter-spacing: 0.04em;
    margin: 0;
    opacity: 0.8;
  }

  .glaze__pick {
    grid-column: 9 / 13;
    align-self: start;
  }
  .glaze__group {
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 14px;
  }
  .glaze__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 12px;
    margin-bottom: 36px;
  }
  .glaze__btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
    text-align: left;
    cursor: pointer;
  }
  .glaze__btn img {
    width: min(84px, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid transparent;
    outline-offset: 4px;
    transition:
      transform 0.7s var(--ease),
      outline-color 0.3s var(--ease);
  }
  .glaze__btn:hover img {
    transform: scale(1.08) rotate(-10deg);
  }
  .glaze__btn[aria-pressed='true'] {
    color: var(--ink);
  }
  .glaze__btn[aria-pressed='true'] img {
    outline-color: var(--ink);
  }
  .glaze__btn:focus-visible {
    outline: none;
  }
  .glaze__btn:focus-visible img {
    outline: var(--focus-ring) solid var(--ink);
  }

  @media (max-width: 1200px) and (min-width: 901px) {
    .glaze__stage {
      grid-column: 1 / 7;
    }
    .glaze__pick {
      grid-column: 7 / 13;
    }
  }
  @media (max-width: 900px) {
    .glaze__stage,
    .glaze__pick {
      grid-column: 1 / -1;
    }
    .glaze__stage {
      min-height: 40svh;
      margin-inline: calc(var(--m) * -1);
      position: sticky;
      top: var(--head);
      z-index: 2;
    }
    .glaze__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.glaze__layer),
    :global(.glaze__layer)::before,
    .glaze__stage,
    .glaze__btn img {
      transition: none !important;
    }
  }
</style>
