---
import type { DatumEintrag } from '../data/typen';

interface Props {
  eintraege: readonly DatumEintrag[];
  /** `liste`: nummerierte Liste (Lebensdaten); `definition`: Definitionsliste (Stichwort links, Erklärung rechts) */
  art?: 'liste' | 'definition';
  /** Zeilen blenden beim Scrollen ein */
  einblenden?: boolean;
  /** Klassen für die Platzierung im Seitenraster, z. B. `grid__full` */
  class?: string | undefined;
}

const { eintraege, art = 'liste', einblenden = false, class: klasse } = Astro.props;
const reveal = einblenden ? 'fade' : undefined;
const zeilen = (text: DatumEintrag['text']) => (typeof text === 'string' ? [text] : text);
---

{art === 'liste' ? (
  <ol class:list={['datelist', klasse]}>
    {eintraege.map((eintrag) => (
      <li class="datelist__row" data-reveal={reveal}>
        <span class="datelist__year">{eintrag.jahr}</span>
        <p class="datelist__text">
          {zeilen(eintrag.text).map((zeile, i) => (
            <Fragment>
              {i > 0 && <br />}
              {zeile}
            </Fragment>
          ))}
        </p>
      </li>
    ))}
  </ol>
) : (
  <dl class:list={['datelist', klasse]}>
    {eintraege.map((eintrag) => (
      <div class="datelist__row" data-reveal={reveal}>
        <dt class="datelist__year">{eintrag.jahr}</dt>
        <dd class="datelist__text">
          {zeilen(eintrag.text).map((zeile, i) => (
            <Fragment>
              {i > 0 && <br />}
              {zeile}
            </Fragment>
          ))}
        </dd>
      </div>
    ))}
  </dl>
)}

<style>
  /* Jahreszahl-Liste (Chronik, Biografie, Ausstellungen, Auszeichnungen) */
  .datelist {
    border-top: 1px solid var(--ink);
  }
  .datelist__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--g);
    padding: 18px 0;
    border-bottom: 1px solid var(--hair);
    align-items: baseline;
  }
  .datelist__year {
    grid-column: 1 / 3;
    font-family: var(--f-display);
    font-size: var(--t-numeral);
    line-height: var(--t-numeral-lh);
    font-variant-numeric: lining-nums;
    white-space: nowrap;
  }
  .datelist__text {
    grid-column: 3 / 10;
    max-width: 68ch;
    margin: 0;
    font-size: var(--t-small);
    line-height: var(--t-small-lh);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .datelist__year {
      grid-column: 1 / 4;
    }
    .datelist__text {
      grid-column: 4 / -1;
    }
  }
</style>
