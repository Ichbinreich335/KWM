---
interface Props {
  /** `gross`: Display-Zitat als Zäsur; `aussage`: Aussage in Textgröße Statement; `regel`: wie `aussage`, mit engerem Satz und Abstand */
  typ: 'gross' | 'aussage' | 'regel';
  /** Urheber oder Quelle unter dem Satz */
  quelle?: string;
  /** Id des Satzes, wenn ein Abschnitt per `aria-labelledby` darauf zeigt */
  textId?: string;
  /** Zusätzliche Klassen für die Platzierung durch die Seite (am `blockquote`, ohne Quelle am `p`) */
  class?: string | undefined;
}

const { typ, quelle, textId, class: klasse } = Astro.props;
---

<blockquote class:list={['statement', klasse]}>
  <p class:list={['statement__text', `statement--${typ}`]} id={textId} data-reveal="words">
    <slot />
  </p>
  {quelle && <footer data-reveal="fade">{quelle}</footer>}
</blockquote>

<style>
  .statement {
    margin: 0;
  }
  .statement__text {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--t-statement);
    line-height: var(--t-statement-lh);
    text-wrap: balance;
  }
  .statement footer {
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
  }
  .statement--gross {
    font-size: var(--t-display);
    line-height: var(--t-display-lh);
    letter-spacing: -0.025em;
  }
  .statement--gross:has(+ footer) {
    margin-bottom: 28px;
  }
  .statement--aussage {
    letter-spacing: -0.02em;
  }
  .statement--aussage:has(+ footer) {
    margin-bottom: 22px;
  }
  .statement--regel {
    letter-spacing: -0.015em;
  }
  .statement--regel:has(+ footer) {
    margin-bottom: 18px;
  }
</style>
