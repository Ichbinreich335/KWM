---
interface Props {
  /** `gross`: Display-Zitat als Zäsur; `aussage`: Aussage in Textgröße Statement; `regel`: wie `aussage`, mit engerem Satz und Abstand */
  typ: 'gross' | 'aussage' | 'regel';
  /** Urheber oder Quelle unter dem Satz */
  quelle?: string;
  /** Id des Satzes, wenn ein Abschnitt per `aria-labelledby` darauf zeigt */
  textId?: string;
  /** Zusätzliche Klassen für die Platzierung durch die Seite */
  class?: string | undefined;
}

const { typ, quelle, textId, class: klasse } = Astro.props;
---

<blockquote class:list={['statement', `statement--${typ}`, klasse]}>
  <p id={textId} data-reveal="words">
    <slot />
  </p>
  {quelle && <footer data-reveal="fade">{quelle}</footer>}
</blockquote>

<style>
  .statement {
    margin: 0;
  }
  .statement p {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--t-statement);
    line-height: var(--t-statement-lh);
    text-wrap: balance;
  }
  .statement footer {
    margin-top: var(--abstand);
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
  }
  .statement--gross {
    --abstand: 28px;
  }
  .statement--gross p {
    font-size: var(--t-display);
    line-height: var(--t-display-lh);
    letter-spacing: -0.025em;
  }
  .statement--aussage {
    --abstand: 22px;
  }
  .statement--aussage p {
    letter-spacing: -0.02em;
  }
  .statement--regel {
    --abstand: 18px;
  }
  .statement--regel p {
    letter-spacing: -0.015em;
  }
</style>
