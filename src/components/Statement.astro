---
interface Props {
  /** `gross`: Display-Zitat als Zäsur; `aussage`: Aussage in Textgröße Statement; `regel`: wie `aussage`, mit engerem Satz und Abstand; `zitat`: Text-Schnitt in Titelgröße, ruhig; `zitat-klein`: längeres Zitat im Text-Schnitt in Zitatgröße */
  typ: 'gross' | 'aussage' | 'regel' | 'zitat' | 'zitat-klein';
  /** `p`: nackter Absatz ohne `blockquote` (Aussage ohne Zitat, keine Quelle) */
  als?: 'blockquote' | 'p';
  /** Einblend-Animation des Satzes; `keine` lässt `data-reveal` weg */
  einblendung?: 'words' | 'fade' | 'keine';
  /** Urheber oder Quelle unter dem Satz */
  quelle?: string;
  /** Id des Satzes, wenn ein Abschnitt per `aria-labelledby` darauf zeigt */
  textId?: string;
  /** Zusätzliche Klassen für die Platzierung durch die Seite (am `blockquote`, ohne Quelle am `p`) */
  class?: string | undefined;
}

const { typ, als = 'blockquote', einblendung = 'words', quelle, textId, class: klasse } = Astro.props;
const reveal = einblendung === 'keine' ? undefined : einblendung;
---

{als === 'p' ? (
  <p class:list={['statement__text', `statement--${typ}`, klasse]} id={textId} data-reveal={reveal}>
    <slot />
  </p>
) : (
  <blockquote class:list={['statement', klasse]}>
    <p class:list={['statement__text', `statement--${typ}`]} id={textId} data-reveal={reveal}>
      <slot />
    </p>
    {quelle && <footer data-reveal={reveal && 'fade'}>{quelle}</footer>}
  </blockquote>
)}

<style>
  .statement {
    margin: 0;
  }
  .statement__text {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--t-statement);
    line-height: var(--t-statement-lh);
    text-wrap: balance;
  }
  .statement footer {
    font-size: var(--t-meta);
    line-height: var(--t-meta-lh);
    color: var(--ink-2);
  }
  .statement--gross {
    font-size: var(--t-display);
    line-height: var(--t-display-lh);
    letter-spacing: -0.025em;
  }
  .statement--gross:has(+ footer) {
    margin-bottom: 28px;
  }
  .statement--aussage {
    letter-spacing: -0.02em;
  }
  .statement--aussage:has(+ footer) {
    margin-bottom: 22px;
  }
  .statement--regel {
    letter-spacing: -0.015em;
  }
  .statement--regel:has(+ footer) {
    margin-bottom: 18px;
  }
  .statement--zitat {
    font-family: var(--f-text);
    font-size: var(--t-h3);
    line-height: var(--t-h3-lh);
    text-wrap: pretty;
  }
  .statement--zitat:has(+ footer),
  .statement--zitat-klein:has(+ footer) {
    margin-bottom: 1em;
  }
  .statement--zitat-klein {
    font-family: var(--f-text);
    font-size: var(--t-quote);
    line-height: var(--t-quote-lh);
    text-wrap: pretty;
  }
</style>
