---
import { Font, fontData } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { NavKey } from '../data/navigation';

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  nav?: NavKey;
}
const { title, description, bodyClass, nav } = Astro.props;

// Die Fonts API kann lokale Schriften nicht nach Teilmenge vorladen. Darum die zwei Dateien über fontData wählen:
// Die latin-Variante steht in astro.config.mjs (varianten) immer vor latin-ext. Ob es wirklich die latin-Datei ist, prüft tests/routen.spec.ts.
const vorgeladeneSchriften = (['--font-caslon-display', '--font-jost'] as const).map((cssVariable) => {
  const url = fontData[cssVariable]?.find((schnitt) => schnitt.style === 'normal')?.src[0]?.url;
  if (url === undefined) throw new Error(`Keine Schriftdatei für ${cssVariable} gefunden (siehe astro.config.mjs).`);
  return url;
});
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/img/kwm/logo.svg" type="image/svg+xml" />
    {vorgeladeneSchriften.map((url) => (
      <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
    ))}
    <Font cssVariable="--font-caslon-display" />
    <Font cssVariable="--font-caslon-text" />
    <Font cssVariable="--font-jost" />
    <slot name="head" />
    {/* Muss vor dem ersten Rendern laufen (Logo-Zeichnung einmal pro Sitzung), daher inline */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (!sessionStorage.getItem('kwm-logo')) {
          sessionStorage.setItem('kwm-logo', '1');
          document.documentElement.classList.add('logo-draw');
        }
      } catch {
        document.documentElement.classList.add('logo-draw');
      }
    </script>
  </head>
  <body class={bodyClass}>
    <Header current={nav} />
    <slot />
    <Footer />
    <script>
      import '../scripts/main';
      import '../scripts/signaturen';
      import '../scripts/expander';
    </script>
  </body>
</html>
