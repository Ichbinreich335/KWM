---
import '../styles/basis.css';
import { ladeSeite } from '../data/seiten';
import PersonCard from '../components/PersonCard.astro';
import { team } from '../data/team';
import FactsList from '../components/FactsList.astro';
import { methodenfakten, ortsfakten } from '../data/werkstatt';
import DateList from '../components/DateList.astro';
import { werkstattAuszeichnungen } from '../data/vita';
import ChapterHead from '../components/ChapterHead.astro';
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryBand from '../components/InquiryBand.astro';
import SubNav from '../components/SubNav.astro';
import PageHero from '../components/PageHero.astro';
import Chronicle from '../components/Chronicle.astro';
import { chronik } from '../data/chronik';
import '../styles/seiten/page-werkstatt.css';
import '../styles/signaturen/signaturen.css';

const seite = await ladeSeite('werkstatt');
---

<BaseLayout
  title="Werkstatt · Keramische Werkstatt Margaretenhöhe"
  description={seite.beschreibung}
  bodyClass="page-werkstatt"
  nav="werkstatt"
>
  <main id="inhalt">
    <PageHero typ="anker" streifen bildunterschrift="Young-Jae Lee in der Werkstatt">
      <Fragment slot="titel">{seite.titel}</Fragment>
      <Fragment slot="lede">{seite.einleitung}</Fragment>
      <Bild
        slot="bild"
        priority
        src="/img/kwm/werkstatt-panorama.webp"
        width="2560"
        height="398"
        alt="Young-Jae Lee an der Arbeit vor langen Regalen mit gedrehten Gefäßen"
      />
    </PageHero>

    <SubNav
      beschriftung="Kapitel dieser Seite"
      eintraege={[
        { href: '#arbeitsweise', text: 'Arbeitsweise' },
        { href: '#feuer', text: 'Glasurfarben' },
        { href: '#chronik', text: 'Chronik' },
        { href: '#team', text: 'Team' },
        { href: '#auszeichnungen', text: 'Auszeichnungen' },
        { href: '#zollverein', text: 'Zeche Zollverein' },
      ]}
    />

    {/* Arbeitsweise */}
    <ChapterHead id="arbeitsweise" titelId="method-title">
      <Fragment slot="titel">Arbeitsweise</Fragment>
      <Fragment slot="einleitung">
        Das Manufakturprogramm der Werkstatt – vor über zwanzig Jahren entwickelt, bis heute unverändert.
      </Fragment>
      <div class="method grid">
        <figure class="method__media" data-reveal="img">
          <Bild
            src="/img/kwm/regal.webp"
            width="954"
            height="905"
            loading="lazy"
            alt="Ein Regal voller ungebrannter Tassen, Schalen, Teller und Krüge aus hellem Steinzeug"
          />
          <figcaption>Geschirr vor dem Brand · Foto: Haydar Koyupinar</figcaption>
        </figure>
        <div class="method__text">
          <p class="method__rule" data-reveal="fade">
            „Jedes Stück muss gut zu drehen sein und auch zu benutzen.“
          </p>
          <p data-reveal="fade">
            Unter Rückbesinnung auf die formalen Grundprinzipien des Bauhauses hat Young-Jae Lee mit Hildegard Eggemann,
            Michael Schmandt und Claudia Neumann vor über zwanzig Jahren die charakteristische Formensprache des
            Manufakturprogramms der Keramischen Werkstatt Margaretenhöhe entwickelt.
          </p>
          <p data-reveal="fade">
            Ihre wichtigsten Vorgaben waren: Jedes Stück muss gut zu drehen sein und auch zu benutzen. Alle Teile eines
            Geschirrs, gleich welcher Farbe, sollten miteinander kombinierbar sein.
          </p>
          <p data-reveal="fade">
            Zunächst wurden die 25 Grundelemente eines Geschirrs entworfen: Teller, Schalen, Krüge. In monatelangen
            Experimenten entstand die 6-tonige Farbskala, von Schattierungen des Jadegrün über ein gebrochenes Weiß bis
            zu Rostbraun. Diese Grundzüge des Manufakturprogramms haben sich bis heute nicht verändert und sind keiner
            Mode, keinem Zeitgeist unterworfen.
          </p>
          <p data-reveal="fade">
            Mit der Edition wurde das Programm mittlerweile um zusätzliche Stücke erweitert, darunter Vasen,
            Pflanzengefäße und Dosen. Es werden ausschließlich umweltschonende Materialien und Fertigungsverfahren
            angewendet. Alle Stücke sind spülmaschinenfest.
          </p>
          <a class="link-arrow" href="/manufaktur">
            Zum Manufakturprogramm
          </a>
        </div>
        <FactsList typ="raster" fakten={methodenfakten} einblenden />
      </div>
    </ChapterHead>

    {/* Glasurfarben */}
    <ChapterHead id="feuer" titelId="fire-title">
      <Fragment slot="titel">Wie die Glasur ihre Farbe bekommt.</Fragment>
      <Fragment slot="einleitung">
        Ob ein Metalloxid gelb, grün oder rot färbt, entscheidet die Atmosphäre im Ofen.
      </Fragment>
      <div class="fire-colors grid">
        <figure class="fire-colors__media" data-reveal="img">
          <Bild
            src="/img/kwm/seladon-schalen.webp"
            width="900"
            height="600"
            loading="lazy"
            alt="Flache Schalen mit blaugrüner Glasur, die sich in der Mitte sammelt"
          />
          <figcaption>Schalen von Young-Jae Lee · Foto: Christopher Clem Franken</figcaption>
        </figure>
        <div class="feuer-farben" data-sig="feuer">
          <h3 class="feuer-farben__title">Dieselbe Glasur, andere Farbe</h3>
          <p class="feuer-farben__intro">
            Dasselbe Metalloxid färbt eine Glasur je nach Ofenatmosphäre unterschiedlich. Wählen Sie Oxid und
            Atmosphäre: Die Schale bleibt gleich, nur die Farbe wechselt.
          </p>
          <ul class="feuer-farben__list">
            <li>
              <span class="swatch" style="--c: var(--glaze-iron-ox)"></span>Eisenoxid, oxidierend: färbt gelb bis braun
              – sauerstoffreiche Ofenatmosphäre.
            </li>
            <li>
              <span class="swatch" style="--c: var(--glaze-iron-red)"></span>Eisenoxid, reduzierend: färbt grün –
              sauerstoffarme Ofenatmosphäre.
            </li>
            <li>
              <span class="swatch" style="--c: var(--glaze-copper-g)"></span>Kupfer, oxidierend: grün.
            </li>
            <li>
              <span class="swatch" style="--c: var(--glaze-copper-r)"></span>Kupfer, reduzierend: rot.
            </li>
          </ul>
        </div>
      </div>
    </ChapterHead>

    {/* Chronik */}
    <Chronicle
      eintraege={chronik}
      id="chronik"
      titelId="chron-title"
      titel="Hundert Jahre an der Scheibe."
      lede="Von der Siedlung Margaretenhöhe über die Bauhaus-Manufaktur bis in das Baulager der Zeche Zollverein."
    />

    {/* Team */}
    <ChapterHead id="team" titelId="team-title">
      <Fragment slot="titel">Team</Fragment>
      <Fragment slot="einleitung">
        Die Menschen hinter dem Manufakturprogramm – manche seit Jahrzehnten in der Werkstatt.
      </Fragment>
      <figure class="team-strip" data-reveal="img">
        <Bild
          src="/img/kwm/leiste-team.webp"
          width="900"
          height="140"
          loading="lazy"
          alt="Das Team der Werkstatt vor Regalen mit Keramik"
        />
      </figure>
      <div class="people">
        {team.map((person) => (
          <PersonCard person={person} />
        ))}
      </div>
    </ChapterHead>

    {/* Auszeichnungen */}
    <ChapterHead ton="flaeche" id="auszeichnungen" titelId="awards-title">
      <Fragment slot="titel">Auszeichnungen</Fragment>
      <div class="grid">
        <DateList eintraege={werkstattAuszeichnungen} class="grid__full" />
      </div>
    </ChapterHead>

    {/* Zeche Zollverein */}
    <ChapterHead id="zollverein" titelId="place-title">
      <div class="place grid">
        <div class="place__text">
          <h2 class="h2" id="place-title" data-reveal="words">
            Auf Zollverein.
          </h2>
          <p data-reveal="fade">
            1933 zog die Werkstatt in ein Gebäude der Zeche Zollverein, 1987 in das Baulager der Zeche – heute
            Weltkulturerbe. Hier wird gedreht, glasiert und gebrannt, und hier können Sie die Werkstatt besuchen.
          </p>
          <a class="link-arrow" href="/besuch" data-reveal="fade">
            Besuch &amp; Anfahrt
          </a>
        </div>
        <FactsList typ="ort" fakten={ortsfakten} einblenden />
      </div>
    </ChapterHead>

    <InquiryBand
      text="Fragen zur Werkstatt oder Interesse an Stücken aus unserem Programm? Wir senden Ihnen gerne weitere Informationen oder ein Angebot zu."
      stueck="Anfrage Werkstatt"
    >
      Selbstverständlich können Sie unsere Werkstatt auch besuchen.{' '}
      <a class="link-arrow" href="/besuch">
        Besuch planen
      </a>
    </InquiryBand>
  </main>
</BaseLayout>
