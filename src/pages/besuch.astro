---
import '../styles/basis.css';
import Steps from '../components/Steps.astro';
import { anfahrtAuto, oepnv } from '../data/anfahrt';
import SectionHead from '../components/SectionHead.astro';
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/seiten/page-besuch.css';
import '../styles/signaturen/signaturen.css';
---

<BaseLayout
  title="Besuch & Anfahrt · Keramische Werkstatt Margaretenhöhe"
  description="Öffnungszeiten, Anfahrt und Anfrage: Keramische Werkstatt Margaretenhöhe, Bullmannaue 19, 45327 Essen, auf dem Gelände der Zeche Zollverein."
  bodyClass="page-besuch"
  nav="besuch"
>
  <main id="inhalt">
    <PageHero typ="meta">
      <Fragment slot="titel">Besuchen Sie die Werkstatt.</Fragment>
      <Fragment slot="lede">
        Wir danken Ihnen für Ihr Interesse. Wenn Sie Fragen haben oder Stücke aus unserem Programm erwerben möchten,
        senden wir Ihnen natürlich gerne weitere Informationen oder ein Angebot zu. Selbstverständlich können Sie unsere
        Werkstatt auch besuchen.
      </Fragment>
      <div class="visit-hours__times" data-reveal="fade" role="group" aria-label="Öffnungszeiten">
        <div class="visit-hours__row">
          <span class="visit-hours__day">Montag bis Freitag</span>
          <span class="visit-hours__time">9–17 Uhr</span>
        </div>
        <div class="visit-hours__row">
          <span class="visit-hours__day">Samstag</span>
          <span class="visit-hours__time">11–15 Uhr</span>
        </div>
        <div class="visit-hours__row">
          <span class="visit-hours__day">Ansonsten</span>
          <span class="visit-hours__time visit-hours__time--small">nach Vereinbarung</span>
        </div>
      </div>
    </PageHero>

    {/* Adresse */}
    <section class="visit-hours" aria-labelledby="hours-title">
      <h2 class="visually-hidden" id="hours-title">
        Adresse
      </h2>
      <figure class="visit-hours__media" data-reveal="img">
        <Bild
          src="/img/kwm/werkstatt-panorama.webp"
          width="2560"
          height="398"
          alt="Young-Jae Lee am Arbeitstisch vor langen Regalen mit ungebrannten Gefäßen"
          loading="eager"
        />
        <figcaption>In der Werkstatt</figcaption>
      </figure>
      <div class="visit-hours__body grid">
        <div class="visit-hours__place" data-reveal="fade">
          <p class="visit-hours__address">
            Keramische Werkstatt Margaretenhöhe GmbH
            <br />
            Bullmannaue 19
            <br />
            45327 Essen
          </p>
          <p class="visit-hours__note">Seit 1987 im Baulager der Zeche Zollverein, heute Weltkulturerbe.</p>
        </div>
        <p class="visit-hours__actions" data-reveal="fade">
          <a class="button" href="https://www.google.com/maps/search/?api=1&amp;query=Bullmannaue+19+45327+Essen">
            Route planen
          </a>
          <a class="link-arrow" href="https://www.openstreetmap.org/search?query=Bullmannaue%2019%2C%2045327%20Essen">
            Route in OpenStreetMap öffnen
          </a>
          <a class="link-arrow" href="tel:+49201305080">
            +49 201 30 50 80
          </a>
        </p>
      </div>
    </section>

    {/* Anfahrt */}
    <section class="routes-band on-flaeche" aria-labelledby="routes-title">
      <SectionHead titelId="routes-title">
        <Fragment slot="titel">So erreichen Sie uns.</Fragment>
        Die Werkstatt liegt auf dem Zechengelände. Nach der Einfahrt links abbiegen, nach etwa 100 Metern auf der linken
        Seite.
      </SectionHead>
      <div class="routes">
        {anfahrtAuto.map((weg) => (
          <article class="route" data-reveal="fade">
            <h3 class="route__title">{weg.titel}</h3>
            <Steps typ="folge" schritte={weg.schritte} />
          </article>
        ))}
        <article class="route" data-reveal="fade">
          <h3 class="route__title">{oepnv.titel}</h3>
          <Steps typ="folge" schritte={oepnv.schritte} />
          {/* Absatz bleibt einzeilig: Umbrüche von Prettier setzen sonst ein Leerzeichen vor das Satzzeichen */}
          {/* prettier-ignore */}
          <p class="route__note">Fahrplanauskünfte erhalten Sie beim <a class="tap" href="https://www.vrr.de/de/fahrplanauskunft/">Verkehrsverbund Rhein-Ruhr</a>.</p>
        </article>
      </div>
    </section>

    {/* Anfrage */}
    <section class="inquiry grid" id="anfrage" aria-labelledby="inquiry-title">
      <div class="inquiry__text">
        <h2 class="h2" id="inquiry-title" data-reveal="words">
          Anfrage
        </h2>
        <p class="inquiry__lead" data-reveal="fade">
          Schreiben Sie uns, welches Stück oder welches Programm Sie interessiert. Wir melden uns mit weiteren
          Informationen oder einem Angebot.
        </p>
        <p data-reveal="fade">
          Für Geschirr und Edition gibt es zusätzlich ein Formular zum Ausdrucken. Zu den Meisterstücken von Young-Jae
          Lee antworten wir gern auf Ihre Nachricht.
        </p>
        <div class="inquiry__forms" data-reveal="fade">
          <a href="https://kwm-1924.de/wp-content/uploads/2026/07/2026_04_Anfrage_inquiry_Geschirr_tableware.pdf">
            <span class="inquiry__form-name">Anfrage – Geschirr</span>
            <span class="inquiry__form-meta">Formular, PDF</span>
          </a>
          <a href="https://kwm-1924.de/wp-content/uploads/2023/09/anfrage_inquiry_editionen_editions.pdf">
            <span class="inquiry__form-name">Anfrage – Edition</span>
            <span class="inquiry__form-meta">Formular, PDF</span>
          </a>
        </div>
        <dl class="inquiry__contact" data-reveal="fade">
          <dt>Telefon</dt>
          <dd>
            <a class="tap" href="tel:+49201305080">
              +49 201 30 50 80
            </a>
          </dd>
          <dt>Zeiten</dt>
          <dd>Mo bis Fr 9–17 Uhr, Sa 11–15 Uhr</dd>
          <dt>E-Mail</dt>
          <dd>
            <a class="tap" href="mailto:kontakt@kwm1924.de">
              kontakt@kwm1924.de
            </a>
          </dd>
          <dt>Fax</dt>
          <dd>+49 201 30 30 31</dd>
        </dl>
      </div>
      <div class="inquiry__form">
        <InquiryForm />
      </div>
    </section>

    {/* Zahlung */}
    <section class="pay grid" aria-labelledby="pay-title">
      <h2 class="h2 pay__head" id="pay-title" data-reveal="words">
        Zahlung
      </h2>
      <dl class="pay__list" data-reveal="fade">
        <div>
          <dt>Banküberweisung</dt>
          <dd>
            Sparkasse Essen
            <br />
            IBAN DE84 3605 0105 0000 2649 37
          </dd>
        </div>
        <div>
          <dt>PayPal</dt>
          <dd>kontakt@kwm1924.de</dd>
        </div>
      </dl>
      <p class="pay__links" data-reveal="fade">
        <a class="link-arrow" href="/versand">
          Verpackung und Transport
        </a>
        <a class="link-arrow" href="/agb">
          AGB
        </a>
        <a class="link-arrow" href="/impressum">
          Impressum
        </a>
      </p>
    </section>
  </main>
</BaseLayout>
