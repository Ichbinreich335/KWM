---
import '../styles/basis.css';
import { ladeSeite } from '../data/seiten';
import { WEICHES_TRENNZEICHEN } from '../data/zeichen';
import WareGroup from '../components/WareGroup.astro';
import DateList from '../components/DateList.astro';
import { arbeitsweise, gruppe } from '../data/manufaktur';
import Statement from '../components/Statement.astro';
import ChapterHead from '../components/ChapterHead.astro';
import { getImage } from 'astro:assets';
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryBand from '../components/InquiryBand.astro';
import SubNav from '../components/SubNav.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/seiten/page-manufaktur.css';
import '../styles/signaturen/signaturen.css';
import { bildMetadaten } from '../data/bilder';

// Die Glasurknöpfe tragen die gebaute Bild-URL in data-img (Doku: Bild-URL an den Client reichen).
const glasurBild = async (src: string) =>
  (
    await getImage({
      src: bildMetadaten(src),
      width: 100,
      height: 100,
      layout: 'constrained',
      fit: 'fill',
      position: 'center',
    })
  ).src;

const seite = await ladeSeite('manufaktur');
---

<BaseLayout
  title="Manufakturprogramm · Keramische Werkstatt Margaretenhöhe"
  description={seite.beschreibung}
  bodyClass="page-manufaktur"
  nav="manufaktur"
>
  <main id="inhalt">
    <PageHero typ="flaeche" titelId="mf-title" class="mf-hero">
      <Fragment slot="titel">
        {seite.titel.replace('Manufakturprogramm', `Manufaktur${WEICHES_TRENNZEICHEN}programm`)}
      </Fragment>
      <Fragment slot="lede">{seite.einleitung}</Fragment>
      <ul class="shelf" data-reveal="img">
        <li class="shelf__item">
          <Bild
            priority
            src="/img/kwm/teller.webp"
            width="600"
            height="400"
            alt="Teller in Dunkelgrün, Hellgrün und Rostbraun, von oben gesehen"
          />
        </li>
        <li class="shelf__item">
          <Bild
            priority
            src="/img/kwm/kannen.webp"
            width="600"
            height="400"
            alt="Krüge in Seladon und Beige und ein dunkelgrüner Becher"
          />
        </li>
        <li class="shelf__item">
          <Bild
            src="/img/kwm/tassen2.webp"
            width="600"
            height="400"
            alt="Teebecher und Trinkbecher in Beige, Seladon und Dunkelbraun"
            loading="eager"
          />
        </li>
        <li class="shelf__item">
          <Bild
            src="/img/kwm/toepfe.webp"
            width="600"
            height="400"
            alt="Deckeldose und Deckeltöpfe in Dunkelbraun, Grau, Orange und Seladon"
            loading="eager"
          />
        </li>
      </ul>
      <div class="plinth" aria-hidden="true"></div>
      <ul class="shelf-caps">
        <li>Teller</li>
        <li>Krüge und Kannen</li>
        <li>Becher und Tassen</li>
        <li>Töpfe und Dosen</li>
      </ul>
    </PageHero>

    <section class="mf-intro on-anker grid" aria-label="Über das Manufakturprogramm">
      <Statement typ="regel" class="mf-intro__rule" quelle="Die wichtigsten Vorgaben für das Manufakturprogramm">
        Jedes Stück muss gut zu drehen sein und auch zu benutzen. Alle Teile eines Geschirrs, gleich welcher Farbe,
        sollten miteinander kombinierbar sein.
      </Statement>
      <figure class="mf-intro__aside" data-reveal="img">
        <Bild
          src="/img/kwm/teekanne.webp"
          width="1030"
          height="687"
          alt="Weiße Teekanne und dunkle Teeschale auf einem hellen, rechteckigen Plattenteller"
          loading="eager"
        />
        <figcaption>Teekanne, Teeschale und Plattenteller</figcaption>
      </figure>
      <div class="mf-intro__text">
        <p data-reveal="fade">
          Unter Rückbesinnung auf die formalen Grundprinzipien des Bauhauses hat Young-Jae Lee mit Hildegard Eggemann,
          Michael Schmandt und Claudia Neumann die charakteristische Formensprache des Manufakturprogramms entwickelt.
        </p>
        <p data-reveal="fade">
          Zunächst wurden die 25 Grundelemente eines Geschirrs entworfen: Teller, Schalen, Krüge. In monatelangen
          Experimenten entstand die sechstonige Farbskala, von Schattierungen des Jadegrün über ein gebrochenes Weiß bis
          zu Rostbraun.
        </p>
      </div>
    </section>

    <SubNav
      beschriftung="Kapitel dieser Seite"
      eintraege={[
        { href: '#geschirr', text: 'Geschirr' },
        { href: '#edition', text: 'Edition' },
        { href: '#farben', text: 'Farben' },
        { href: '#arbeitsweise', text: 'Arbeitsweise' },
      ]}
    />

    {/* Geschirr */}
    <ChapterHead id="geschirr" titelId="geschirr-title">
      <Fragment slot="titel">Geschirr</Fragment>
      <Fragment slot="einleitung">
        Alle Teile eines Geschirrs, gleich welcher Farbe, lassen sich miteinander kombinieren – einzeln oder im Set.
      </Fragment>

      <WareGroup gruppe={gruppe('teller')} />

      <WareGroup gruppe={gruppe('viereckteller')} />

      <WareGroup gruppe={gruppe('schalen-und-schuesseln')} />
    </ChapterHead>

    {/* Zäsur: Regal der Werkstatt */}
    <section class="zaesur on-flaeche grid" aria-label="Handarbeit in der Werkstatt">
      <figure class="zaesur__media" data-reveal="img">
        <Bild
          src="/img/kwm/regal.webp"
          width="954"
          height="905"
          loading="lazy"
          alt="Regal voller ungebrannter Becher, Schalen, Teller und Krüge in hellem Tonbeige"
        />
        <figcaption>Im Regal der Werkstatt · Foto: Haydar Koyupinar</figcaption>
      </figure>
      <Statement typ="regel" als="p" class="zaesur__text">
        Alle Stücke werden in unserer Werkstatt in Handarbeit gefertigt. Sie sind einzeln oder im Set zu erwerben.
      </Statement>
    </section>

    <ChapterHead class="chapter--cont" beschriftung="Geschirr, Fortsetzung">
      <WareGroup gruppe={gruppe('becher-und-tassen')} />

      <WareGroup gruppe={gruppe('toepfe-und-dosen')} />

      <WareGroup gruppe={gruppe('flaschen-kruege-kannen')} />

      <WareGroup gruppe={gruppe('weitere-stuecke')} />
    </ChapterHead>

    {/* Edition */}
    <ChapterHead ton="flaeche" id="edition" titelId="edition-title">
      <Fragment slot="titel">Edition</Fragment>
      <Fragment slot="einleitung">
        In unserer Edition sind weitere ergänzende Geschirrstücke erhältlich, wie zum Beispiel Sushi- oder
        Plattenteller, sowie Pflanzengefäße und Vasen. Sie unterscheiden sich in der Farbgebung von unserem Geschirr.
      </Fragment>

      <WareGroup gruppe={gruppe('vasen-edition')} />

      <WareGroup gruppe={gruppe('plattenteller-edition')} />

      <WareGroup gruppe={gruppe('pflanzgefaesse-edition')} />

      <WareGroup gruppe={gruppe('schalen-und-dosen-edition')} />
    </ChapterHead>

    {/* Farben */}
    <ChapterHead id="farben" titelId="farben-title">
      <Fragment slot="titel">Sechs Töne für das Geschirr.</Fragment>
      <Fragment slot="einleitung">
        Die Farben der Edition unterscheiden sich vom Geschirr und können je nach Brand unterschiedlich ausfallen.
        Wählen Sie eine Glasurprobe.
      </Fragment>

      <div class="glaze grid" data-glaze>
        <div class="glaze__stage" data-glaze-stage aria-live="polite">
          <div class="glaze__layers" data-glaze-layers aria-hidden="true"></div>
          <div class="glaze__label">
            <p class="glaze__name" data-glaze-name>
              weiß
            </p>
            <p class="glaze__meta" data-glaze-meta>
              Geschirr
            </p>
          </div>
        </div>
        <div class="glaze__pick">
          <p class="glaze__group">Geschirr</p>
          <ul class="glaze__list">
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="true"
                data-name="weiß"
                data-meta="Geschirr"
                data-color="#e1dccc"
                data-img={await glasurBild('/img/kwm/weiss.webp')}
              >
                <Bild src="/img/kwm/weiss.webp" width="100" height="100" alt="" loading="lazy" />
                <span>weiß</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="hellgrün matt"
                data-meta="Geschirr · matt"
                data-color="#cfe0d5"
                data-img={await glasurBild('/img/kwm/hellgruen_matt.webp')}
              >
                <Bild src="/img/kwm/hellgruen_matt.webp" width="100" height="100" alt="" loading="lazy" />
                <span>hellgrün matt</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="hellgrün glänzend"
                data-meta="Geschirr · glänzend"
                data-color="#92ad9b"
                data-img={await glasurBild('/img/kwm/hellgruen_glaenzend.webp')}
                data-gloss
              >
                <Bild src="/img/kwm/hellgruen_glaenzend.webp" width="100" height="100" alt="" loading="lazy" />
                <span>hellgrün glänzend</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="dunkelgrün glänzend"
                data-meta="Geschirr · glänzend"
                data-color="#3f3b22"
                data-img={await glasurBild('/img/kwm/dunkelgruen_glaenzend.webp')}
                data-gloss
                data-dark
              >
                <Bild src="/img/kwm/dunkelgruen_glaenzend.webp" width="100" height="100" alt="" loading="lazy" />
                <span>dunkelgrün glänzend</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="dunkelgrün matt"
                data-meta="Geschirr · matt"
                data-color="#474931"
                data-img={await glasurBild('/img/kwm/dunkelgruen_matt.webp')}
                data-dark
              >
                <Bild src="/img/kwm/dunkelgruen_matt.webp" width="100" height="100" alt="" loading="lazy" />
                <span>dunkelgrün matt</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="rostbraun"
                data-meta="Geschirr"
                data-color="#8c580a"
                data-img={await glasurBild('/img/kwm/rostbraun.webp')}
                data-dark
              >
                <Bild src="/img/kwm/rostbraun.webp" width="100" height="100" alt="" loading="lazy" />
                <span>rostbraun</span>
              </button>
            </li>
          </ul>
          <p class="glaze__group">Edition</p>
          <ul class="glaze__list">
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="hellblau"
                data-meta="Edition"
                data-color="#75857a"
                data-img={await glasurBild('/img/kwm/hellblau.webp')}
                data-dark
              >
                <Bild src="/img/kwm/hellblau.webp" width="100" height="100" alt="" loading="lazy" />
                <span>hellblau</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="weiß"
                data-meta="Edition · Craquelé"
                data-color="#c3bcaf"
                data-img={await glasurBild('/img/kwm/craquele_weiss.webp')}
              >
                <Bild src="/img/kwm/craquele_weiss.webp" width="100" height="100" alt="" loading="lazy" />
                <span>weiß</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="hellgrün"
                data-meta="Edition · Craquelé"
                data-color="#848d7a"
                data-img={await glasurBild('/img/kwm/craquele_hellgruen.webp')}
                data-dark
              >
                <Bild src="/img/kwm/craquele_hellgruen.webp" width="100" height="100" alt="" loading="lazy" />
                <span>hellgrün</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="glaze__btn"
                aria-pressed="false"
                data-name="dunkelgrün"
                data-meta="Edition · Craquelé"
                data-color="#5a6251"
                data-img={await glasurBild('/img/kwm/craquele_dunkelgruen.webp')}
                data-dark
              >
                <Bild src="/img/kwm/craquele_dunkelgruen.webp" width="100" height="100" alt="" loading="lazy" />
                <span>dunkelgrün</span>
              </button>
            </li>
          </ul>
        </div>
      </div>
    </ChapterHead>

    {/* Arbeitsweise */}
    <ChapterHead id="arbeitsweise" titelId="mf-aw-title">
      <Fragment slot="titel">Keiner Mode, keinem Zeitgeist unterworfen.</Fragment>
      <Fragment slot="einleitung">
        Die Grundzüge des Manufakturprogramms haben sich bis heute nicht verändert. Mit der Edition wurde es um
        zusätzliche Stücke erweitert, darunter Vasen, Pflanzengefäße und Dosen.
      </Fragment>
      <div class="grid">
        <DateList eintraege={arbeitsweise} art="definition" einblenden class="grid__full mf-facts" />
      </div>
    </ChapterHead>

    <InquiryBand
      text="Bei Interesse senden wir Ihnen gerne weitere Informationen oder ein Angebot zu."
      stueck="Anfrage Manufakturprogramm"
    >
      Nennen Sie uns gern das Geschirr oder die Edition, die Sie interessiert. Für eine Bestellung gibt es
      Anfrageformulare:{' '}
      <a
        class="link-arrow"
        href="https://kwm-1924.de/wp-content/uploads/2026/07/2026_04_Anfrage_inquiry_Geschirr_tableware.pdf"
      >
        Geschirr (PDF)
      </a>{' '}
      <a
        class="link-arrow"
        href="https://kwm-1924.de/wp-content/uploads/2023/09/anfrage_inquiry_editionen_editions.pdf"
      >
        Edition (PDF)
      </a>
    </InquiryBand>

    <script>
      (() => {
        // Glasurbühne: die Probe wird zur Fläche
        const root = document.querySelector('[data-glaze]');
        if (!root) return;
        const stage = root.querySelector('[data-glaze-stage]');
        const layers = root.querySelector('[data-glaze-layers]');
        const nameEl = root.querySelector('[data-glaze-name]');
        const metaEl = root.querySelector('[data-glaze-meta]');
        const buttons = [...root.querySelectorAll<HTMLButtonElement>('.glaze__btn')];
        const [first] = buttons;
        if (!stage || !layers || !nameEl || !metaEl || !first) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let current: HTMLButtonElement | null = null;

        const show = (btn: HTMLButtonElement) => {
          if (btn === current) return;
          current = btn;
          const layer = document.createElement('div');
          layer.className = 'glaze__layer';
          layer.style.setProperty('--g', btn.dataset.color ?? '');
          layer.style.setProperty('--img', `url("${new URL(btn.dataset.img ?? '', location.href).href}")`);
          if ('gloss' in btn.dataset) layer.classList.add('is-gloss');
          layers.appendChild(layer);
          requestAnimationFrame(() => layer.classList.add('is-in'));
          const old = [...layers.children].slice(0, -1);
          setTimeout(() => old.forEach((l) => l.remove()), reduced ? 0 : 1200);
          stage.classList.toggle('is-dark', 'dark' in btn.dataset);
          nameEl.textContent = btn.dataset.name ?? '';
          metaEl.textContent = btn.dataset.meta ?? '';
        };
        const select = (btn: HTMLButtonElement) => {
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          show(btn);
        };
        let pinned = first;
        buttons.forEach((btn) => {
          btn.addEventListener('pointerenter', (e) => {
            if (e.pointerType === 'mouse') show(btn);
          });
          btn.addEventListener('focus', () => select(btn));
          btn.addEventListener('click', () => {
            pinned = btn;
            select(btn);
          });
        });
        root.querySelector('.glaze__pick')?.addEventListener('pointerleave', () => show(pinned));
        select(pinned);
      })();
    </script>
  </main>
</BaseLayout>
