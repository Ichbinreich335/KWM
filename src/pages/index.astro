---
import '../styles/basis.css';
import LinkArrow from '../components/LinkArrow.astro';
import Statement from '../components/Statement.astro';
import SectionHead from '../components/SectionHead.astro';
import { grundformen } from '../data/manufaktur';
import WorkTile from '../components/WorkTile.astro';
import { stueckBezeichnung, werk, werkschau } from '../data/werke';
import { anfrageLink } from '../scripts/anfrage-link';
import SigAktuell from '../components/SigAktuell.astro';
import { ausstellungen } from '../data/ausstellungen';
import { hinweise } from '../data/hinweise';
import { kontakt } from '../data/kontakt';
import Hours from '../components/Hours.astro';
import PlaceGrid from '../components/PlaceGrid.astro';
import { kacheln } from '../data/orte';
import Timeline from '../components/Timeline.astro';
import Chronicle from '../components/Chronicle.astro';
import { chronik } from '../data/chronik';
import { lebensweg } from '../data/lebensweg';
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Figure from '../components/Figure.astro';
import SigSticky from '../components/SigSticky.astro';
import SigFarbskala from '../components/SigFarbskala.astro';
import { glasuren } from '../data/glasuren';
---

<BaseLayout
  title="Keramische Werkstatt Margaretenhöhe · seit 1924"
  description="Gedrehte Gefäße von Young-Jae Lee und ein Manufakturprogramm nach den Formprinzipien des Bauhauses. Keramische Werkstatt Margaretenhöhe, Zeche Zollverein, Essen."
  bodyClass="page-home"
>
  <main id="inhalt">
    {/* Einstieg: Zitat links, Kummerschalen rechts (hell) */}
    <section class="hero grid" id="top" aria-labelledby="hero-title">
      <Figure
        class="hero__media"
        unterschrift="Kummerschalen · Foto: Christopher Clem Franken"
        unterschriftKlasse="hero__credit"
      >
        <Bild
          priority
          src="/img/kwm/kummerschalen.webp"
          width="937"
          height="1040"
          alt="Viele flache Schalen von Young-Jae Lee auf einem Steinboden, seladonblau, schwarz gesprenkelt und rotbraun glasiert"
          data-parallax
        />
      </Figure>
      <div class="hero__text">
        <h1 class="hero__title" id="hero-title" data-reveal="words">
          Immer sind es Schalen, und doch ist keine wie die andere.
        </h1>
        <p class="hero__source" data-reveal="fade">
          Thomas Wagner über die Schalen von Young-Jae Lee
        </p>
        <p class="hero__intro" data-reveal="fade">
          Gedrehte Gefäße und Gebrauchsgeschirr aus Essen, seit 1924. Heute auf der Zeche Zollverein.
        </p>
        <p class="hero__actions" data-reveal="fade">
          <LinkArrow href="/meisterstuecke">Meisterstücke ansehen</LinkArrow>
          <LinkArrow href="/manufaktur">Manufakturprogramm</LinkArrow>
        </p>
      </div>
    </section>

    {/* Aktuell: laufende und kommende Ausstellungen mit Flyer und Angaben, aufklappbar ohne Unterseite */}
    <SigAktuell {ausstellungen} {hinweise} />

    {/* Bauhaus: das Prinzip als Bild – Grundformen und Farbskala im selben Raster */}
    <section class="principle" id="bauhaus" aria-labelledby="principle-title">
      <SectionHead typ="start" titelId="principle-title">
        <Fragment slot="titel">Seit 1927 in der Tradition des Bauhauses.</Fragment>
        <Statement typ="zitat-klein" einblendung="fade" quelle="Young-Jae Lee">
          „Wir gehen immer von geometrischen Grundformen aus.“
        </Statement>
      </SectionHead>
      <ul class="principle__forms grid" aria-label="Grundformen des Manufakturprogramms">
        {grundformen.map((form) => (
          <li>
            <Figure class="principle__form" unterschrift={form.beschriftung} unterschriftKlasse="principle__name">
              <Bild
                src={form.bild.src}
                width={form.bild.breite}
                height={form.bild.hoehe}
                loading="lazy"
                sizes="(min-width: 900px) 33vw, 100vw"
                alt={form.bild.alt}
              />
            </Figure>
          </li>
        ))}
      </ul>
      <SigFarbskala glasuren={glasuren} />
      <div class="principle__foot grid">
        <p class="principle__rule" data-reveal="fade">
          „Alle Teile eines Geschirrs, gleich welcher Farbe, sollten miteinander kombinierbar sein.“
        </p>
        <LinkArrow href="/manufaktur" data-reveal="fade">
          Zum Manufakturprogramm
        </LinkArrow>
      </div>
    </section>

    {/* Young-Jae Lee */}
    <section class="artist" id="young-jae-lee" aria-labelledby="artist-title">
      <h2 class="artist__name grid" id="artist-title">
        <span data-reveal="words">Young-Jae Lee</span>
      </h2>
      <figure class="sticky-bild-wrap">
        <SigSticky variante="portrait">
          {/* sizes: Bildbreite folgt aus der Kastenhöhe (cover), Höhe x 1,12 (Überstand) x 2000/1313; mobil und hochkant 4:5 = 125vw, Desktop 140vh */}
          <Bild
            slot="bild"
            class="sticky-bild__img"
            src="/img/kwm/portrait-yjl.webp"
            sizes="(max-width: 900px) 213vw, (orientation: portrait) 213vw, max(100vw, 239vh)"
            width="2000"
            height="1313"
            loading="lazy"
            decoding="async"
            alt="Young-Jae Lee in der Werkstatt, vor ihr ungebrannte Schalen und Vasen, hinter ihr Regale voller Gefäße"
          />
          <Statement
            typ="zitat-bild"
            einblendung="keine"
            class="sticky-bild__text sticky-bild__quote"
            quelle="Barbara Catoir, »Gespannte Lebendigkeit«"
          >
            „… eine nach der anderen, ohne je darüber müde zu werden.“
          </Statement>
        </SigSticky>
        <figcaption class="sticky-bild__caption">Young-Jae Lee in der Keramischen Werkstatt Margaretenhöhe</figcaption>
      </figure>

      <Timeline stationen={lebensweg} weiter={{ href: '/young-jae-lee#biografie', text: 'Zum ganzen Werdegang' }} />
    </section>

    {/* Meisterstücke */}
    <section class="works" id="meisterstuecke" aria-labelledby="works-title">
      <SectionHead typ="start" titelId="works-title">
        <Fragment slot="titel">Meisterstücke</Fragment>
        <LinkArrow href="/meisterstuecke">Alle Meisterstücke</LinkArrow>
      </SectionHead>
      <div class="works__feature grid">
        <Figure class="works__single">
          <Bild
            src="/img/kwm/werke/spindelvase-einzeln-1200.webp"
            width="1200"
            height="1200"
            loading="lazy"
            sizes="(min-width: 900px) 55vw, 100vw"
            alt="Weiße Spindelvase mit weiter Schulter und schmalem Fuß auf hellem Grund"
          />
        </Figure>
        <div class="works__single-text">
          <div class="works__single-meta">
            <p class="works__single-name" data-reveal="fade">
              Spindelvase <span>2006/07</span>
            </p>
            <LinkArrow href={anfrageLink(stueckBezeichnung(werk('spindelvase-1')))} data-reveal="fade">
              Zu diesem Stück anfragen
            </LinkArrow>
          </div>
        </div>
      </div>
      <ol class="works__grid grid">
        {werkschau.map((werk) => (
          <WorkTile werk={werk} />
        ))}
      </ol>
    </section>

    {/* Orte: Ausstellungsorte im Bildraster */}
    <PlaceGrid
      orte={kacheln}
      titel="Ausstellungsorte"
      einleitung="Ausstellungen seit 1980 in Europa, Korea, Japan und den USA."
      link={{ href: '/young-jae-lee#ausstellungen', text: 'Alle Ausstellungen' }}
      fussnote="Städte und Zahlen nach der Ausstellungsliste 2016 bis 2026."
    />

    {/* 99 Schalen: keine wie die andere, jede mit eigener Glasur */}
    <section class="rep" id="kosmos" aria-labelledby="kosmos-title">
      <SectionHead typ="start" titelId="kosmos-title">
        <Fragment slot="titel">Ein Ring aus Teilchen um eine leere Mitte.</Fragment>
        <p data-reveal="fade">Thomas Wagner, »Die aufgehobene Zeit?«</p>
      </SectionHead>
      <div class="cosmos__floor">
        <div class="cosmos__stage" data-cosmos>
          <canvas
            class="cosmos__canvas"
            role="img"
            aria-label="Neunundneunzig Schalen von oben gesehen, in einem Ring um eine leere Mitte angeordnet, jede mit eigener Glasur"
          ></canvas>
          <div class="cosmos__center">
            <p class="cosmos__count" data-cosmos-readout>
              99 Schalen
            </p>
            <p class="cosmos__show">Zu sehen im Museum für Ostasiatische Kunst, Köln, bis 25. Oktober 2026</p>
            <LinkArrow href="/aktuelles#kosmos">Zur Ausstellung</LinkArrow>
          </div>
        </div>
        <div class="cosmos__caption">
          <p class="cosmos__show">Zu sehen im Museum für Ostasiatische Kunst, Köln, bis 25. Oktober 2026</p>
          <LinkArrow href="/aktuelles#kosmos">Zur Ausstellung</LinkArrow>
        </div>
      </div>
    </section>

    {/* Feuer: Text bleibt beim Scrollen auf dem Glasurfoto stehen */}
    <SigSticky variante="feuer" als="section" id="feuer" aria-labelledby="feuer-title">
      {/* sizes: Bildbreite folgt aus der Kastenhöhe (cover), Höhe x 1,12 (Überstand) x 1,5; Desktop 160vh, mobil 150vh */}
      <Bild
        slot="bild"
        class="sticky-bild__img"
        src="/img/03-glasur-detail.webp"
        sizes="(max-width: 900px) max(100vw, 252vh), max(100vw, 269vh)"
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
        alt="Nahaufnahme eines Schalenrands mit tintenblauer bis seladonfarbener Glasur, Nadelstichen und Eisensprenkeln"
      />
      <div class="sticky-bild__text">
        <h2 class="h2" id="feuer-title">
          Neun bis zehn Stunden Feuer.
        </h2>
        <p class="sticky-bild__lede">
          Im Holzbrand wird die Tönung reicher, manche Verfärbung lässt sich nicht steuern.
        </p>
        <LinkArrow href="/werkstatt#feuer">Wie die Glasur ihre Farbe bekommt</LinkArrow>
      </div>
    </SigSticky>

    {/* Werkstatt / Chronik */}
    <Chronicle
      eintraege={chronik}
      kurz
      id="werkstatt"
      titelId="chron-title"
      titel="Hundert Jahre an der Scheibe."
      lede="Von der Siedlungswerkstatt in Essen zur Manufaktur auf Zollverein."
      link={{ href: '/werkstatt', text: 'Werkstatt, Team und Chronik' }}
    />

    {/* Besuch */}
    <section class="visit" id="besuch" aria-labelledby="visit-title">
      <SectionHead typ="start" titelId="visit-title">
        <Fragment slot="titel">Die Werkstatt ist offen.</Fragment>
      </SectionHead>
      <div class="visit__body grid">
        <div class="visit__info">
          <Hours typ="tabelle" />
          <p class="visit__actions">
            <LinkArrow href={kontakt.telefonHref}>Lieber anrufen: {kontakt.telefon}</LinkArrow>
            <LinkArrow href="/besuch">Anfahrt und Besuch</LinkArrow>
          </p>
        </div>
        <div class="visit__form" id="anfrage">
          <InquiryForm />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
