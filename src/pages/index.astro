                <td>11–15 Uhr</td>
              </tr>
              <tr>
                <th scope="row">Sonst</th>
                <td>nach Vereinbarung</td>
              </tr>
            </tbody>
          </table>
          <p class="visit__actions">
            <a class="link-arrow" href="tel:+49201305080">
              Lieber anrufen: +49 201 30 50 80
            </a>
            <a class="link-arrow" href="/besuch">
              Anfahrt und Besuch
            </a>
          </p>
        </div>
        <div class="visit__form" id="anfrage">
          <InquiryForm />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
