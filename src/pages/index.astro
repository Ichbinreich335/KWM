---
import '../styles/basis.css';
import Button from '../components/Button.astro';
import LinkArrow from '../components/LinkArrow.astro';
import { BRENNTEMPERATUR, grad } from '../data/brenntemperatur';
import Statement from '../components/Statement.astro';
import SectionHead from '../components/SectionHead.astro';
import FactsTable from '../components/FactsTable.astro';
import { kurzfakten } from '../data/manufaktur';
import WorkTile from '../components/WorkTile.astro';
import { stueckBezeichnung, werk, werkschau } from '../data/werke';
import { anfrageLink } from '../scripts/anfrage-link';
import SigAktuell from '../components/SigAktuell.astro';
import { ausstellungen } from '../data/ausstellungen';
import { hinweise } from '../data/hinweise';
import { kontakt } from '../data/kontakt';
import Hours from '../components/Hours.astro';
import PlaceGrid from '../components/PlaceGrid.astro';
import { kacheln } from '../data/orte';
import Timeline from '../components/Timeline.astro';
import Chronicle from '../components/Chronicle.astro';
import { chronik } from '../data/chronik';
import { lebensweg } from '../data/lebensweg';
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Figure from '../components/Figure.astro';
import SigSticky from '../components/SigSticky.astro';
import SigFarbskala from '../components/SigFarbskala.astro';
import { glasuren } from '../data/glasuren';
---

<BaseLayout
  title="Keramische Werkstatt Margaretenhöhe · seit 1924"
  description="Gedrehte Gefäße von Young-Jae Lee und ein Manufakturprogramm nach den Formprinzipien des Bauhauses. Keramische Werkstatt Margaretenhöhe, Zeche Zollverein, Essen."
  bodyClass="page-home"
  strukturiert
>
  <main id="inhalt">
    {/* Einstieg: Zitat links, Kummerschalen rechts (hell) */}
    <section class="hero grid" id="top" aria-labelledby="hero-title">
      <Figure
        class="hero__media"
        unterschrift="Kummerschalen · Foto: Christopher Clem Franken"
        unterschriftKlasse="hero__credit"
      >
        <Bild
          priority
          src="/img/kwm/kummerschalen.webp"
          width="937"
          height="1040"
          alt="Viele flache Schalen von Young-Jae Lee auf einem Steinboden, seladonblau, schwarz gesprenkelt und rotbraun glasiert"
        />
      </Figure>
      <div class="hero__text">
        <h1 class="hero__title" id="hero-title" data-reveal="words">
          Immer sind es Schalen, und doch ist keine wie die andere.
        </h1>
        <p class="hero__source" data-reveal="fade">
          Thomas Wagner über die Schalen von Young-Jae Lee
        </p>
        <p class="hero__intro" data-reveal="fade">
          Keramische Werkstatt Margaretenhöhe. Gedrehte Gefäße und Gebrauchsgeschirr aus Essen – seit 1924, heute auf
          dem Gelände der Zeche Zollverein.
        </p>
        <p class="hero__actions" data-reveal="fade">
          <LinkArrow href="/meisterstuecke">Meisterstücke ansehen</LinkArrow>
          <LinkArrow href="/manufaktur">Manufakturprogramm</LinkArrow>
        </p>
      </div>
    </section>

    {/* Aktuell: laufende und kommende Ausstellungen mit Flyer und Angaben, aufklappbar ohne Unterseite */}
    <SigAktuell {ausstellungen} {hinweise} />

    {/* Lede */}
    <section class="lede grid" aria-label="Über die Werkstatt">
      <Statement typ="lede" als="p" class="lede__text">
        Aus der ständigen Wiederholung einer handwerklichen Technik, dem Drehen auf der Töpferscheibe, erwächst die
        vollkommene Schönheit einer Form.
      </Statement>
      <p class="lede__col lede__col--a" data-reveal="fade">
        1924 auf Initiative von Margarete Krupp für die Siedlung Margaretenhöhe gegründet. Seit 1927 den Formprinzipien
        des Bauhauses verpflichtet – über Otto Lindigs Schüler Johannes Leßmann.
      </p>
      <p class="lede__col lede__col--b" data-reveal="fade">
        Seit 1986 geprägt von Young-Jae Lee: Meisterstücke aus ihrer eigenen Hand und ein Geschirr, das seitdem nahezu
        unverändert in der Werkstatt gedreht wird.
      </p>
      <nav class="lines" aria-label="Zwei Linien der Werkstatt">
        <a class="lines__item" href="/meisterstuecke" data-reveal="fade">
          <span class="lines__name">Meisterstücke</span>
          <span class="lines__what">Unikate aus der Hand von Young-Jae Lee: Schalen, Kummen, Vasen</span>
        </a>
        <a class="lines__item" href="/manufaktur" data-reveal="fade">
          <span class="lines__name">Manufaktur</span>
          <span class="lines__what">Geschirr nach Bauhaus-Formprinzipien, in der Werkstatt gedreht und glasiert</span>
        </a>
      </nav>
    </section>

    {/* Young-Jae Lee */}
    <section class="artist" id="young-jae-lee" aria-labelledby="artist-title">
      <h2 class="artist__name grid" id="artist-title">
        <span data-reveal="words">Young-Jae Lee</span>
      </h2>
      <figure class="sticky-bild-wrap">
        <SigSticky variante="portrait">
          {/* sizes: Bildbreite folgt aus der Kastenhöhe (cover), Höhe x 1,12 (Überstand) x 2000/1313; mobil und hochkant 4:5 = 125vw, Desktop 140vh */}
          <Bild
            slot="bild"
            class="sticky-bild__img"
            src="/img/kwm/portrait-yjl.webp"
            sizes="(max-width: 900px) 213vw, (orientation: portrait) 213vw, max(100vw, 239vh)"
            width="2000"
            height="1313"
            loading="lazy"
            decoding="async"
            alt="Young-Jae Lee in der Werkstatt, vor ihr ungebrannte Schalen und Vasen, hinter ihr Regale voller Gefäße"
          />
          <Statement
            typ="zitat-lang"
            einblendung="keine"
            class="sticky-bild__text sticky-bild__quote"
            quelle="Barbara Catoir, »Gespannte Lebendigkeit«"
          >
            „Sie erzählte von den Zeremonien in den Tempeln, dem Ritual eines hundertfachen Niederkniens, Niederfallens
            vor den Buddha-Statuen. Sie erzählte von ihrer Großmutter, die sich diesen geistig-körperlichen Übungen bis
            ins hohe Alter unterzog. Daran habe sie sich immer wieder erinnert, während sie ihre Schalen drehte, eine
            nach der anderen, ohne je darüber müde zu werden.“
          </Statement>
        </SigSticky>
        <figcaption class="sticky-bild__caption">Young-Jae Lee in der Keramischen Werkstatt Margaretenhöhe</figcaption>
      </figure>

      <div class="artist__body grid">
        <Statement typ="zitat" einblendung="fade" class="artist__quote" quelle="Gisela Jahn">
          „Die minimale Veränderung ist Young-Jae Lees unbegrenzter Freiraum – in der Form wie in der Farbigkeit der
          Glasur und der Bemalung. Ihr geht es nicht um Formerfindung, sondern um die Individualität des Gefäßes.“
        </Statement>
        <p class="artist__heritage" data-reveal="fade">
          Zwei Traditionen treffen sich in ihren Gefäßen: die Ideen des Bauhauses, denen sie sich verpflichtet fühlt –
          und ihr koreanisches Erbe, „das heitere, schwerelose Empfinden für die Form und die subtilen Farben“.
          <span class="artist__cite">Gisela Jahn, »Gefäße drehen, Gefäße betrachten, Gefäße benutzen«</span>
        </p>
      </div>

      <Timeline stationen={lebensweg} weiter={{ href: '/young-jae-lee#biografie', text: 'Zum ganzen Werdegang' }} />
    </section>

    {/* Meisterstücke */}
    <section class="works" id="meisterstuecke" aria-labelledby="works-title">
      <SectionHead typ="start" titelId="works-title">
        <Fragment slot="titel">Meisterstücke</Fragment>
        <LinkArrow href="/meisterstuecke">Alle Meisterstücke</LinkArrow>
      </SectionHead>
      <div class="works__feature grid">
        <Figure class="works__single">
          <Bild
            src="/img/kwm/werke/spindelvase-einzeln-1200.webp"
            width="1200"
            height="1200"
            loading="lazy"
            sizes="(min-width: 900px) 55vw, 100vw"
            alt="Weiße Spindelvase mit weiter Schulter und schmalem Fuß auf hellem Grund"
          />
        </Figure>
        <div class="works__single-text">
          <Statement typ="aussage" als="p" class="works__statement">
            Alle Meisterstücke stammen aus der Hand Young-Jae Lees – von ihr selbst gedreht, bemalt und glasiert.
          </Statement>
          <div class="works__single-meta">
            <p class="works__single-name" data-reveal="fade">
              Spindelvase <span>2006/07</span>
            </p>
            <LinkArrow href={anfrageLink(stueckBezeichnung(werk('spindelvase-1')))} data-reveal="fade">
              Zu diesem Stück anfragen
            </LinkArrow>
          </div>
        </div>
      </div>
      <ol class="works__grid grid">
        {werkschau.map((werk) => (
          <WorkTile werk={werk} />
        ))}
      </ol>
    </section>

    {/* Orte: Ausstellungsorte im Bildraster */}
    <PlaceGrid
      orte={kacheln}
      titel="Ausstellungsorte"
      einleitung="Ausstellungen seit 1980 in Europa, Korea, Japan und den USA."
      link={{ href: '/young-jae-lee#ausstellungen', text: 'Alle Ausstellungen' }}
      fussnote="Städte und Zahlen nach der Ausstellungsliste 2016 bis 2026."
    />

    {/* Meditation: Haltung und Arbeitsweise */}
    <section class="med" id="haltung-meditation" aria-labelledby="med-title">
      <div class="med__grid grid">
        <Statement typ="aussage" class="med__quote" textId="med-title">
          Die Herstellung jedes neuen Gefäßes gleicht einer Meditation.
        </Statement>
        <div class="med__body">
          <p data-reveal="fade">
            Für Young-Jae Lee ist – in Anlehnung an die koreanische Tradition – nicht die ständige Neuerfindung von
            Formen entscheidend, sondern die vollkommene Beherrschung des vorhandenen Repertoires. Erst mit der
            Verinnerlichung der Formen wird die tägliche Arbeit an der Drehscheibe jenseits aller Routine zu einer Art
            Exerzitium. Die Persönlichkeit beginnt einzufließen, das Individuelle drückt sich im Handwerklichen aus.
          </p>
        </div>
        <Figure class="med__media">
          <Bild
            src="/img/01-seladon-gefaess.webp"
            sizes="(min-width: 900px) 40vw, 100vw"
            width="1600"
            height="1067"
            loading="lazy"
            alt="Bauchiges Gefäß mit seladongrüner bis taubenblauer Glasur"
          />
        </Figure>
      </div>
    </section>

    {/* 99 Schalen: keine wie die andere, jede mit eigener Glasur */}
    <section class="rep" id="kosmos" aria-labelledby="kosmos-title">
      <SectionHead typ="start" titelId="kosmos-title" rechtsKlasse="cosmos__text">
        <Fragment slot="titel">Ein Ring aus Teilchen um eine leere Mitte.</Fragment>
        <p data-reveal="fade">
          „Schalen über Schalen, einfach auf den Boden gestellt. Ein Meer aus Schalen, ein Feld aus Kelchen, ein Ring
          aus Teilchen um eine leere Mitte, eine kleine Milchstraße voll schimmernder Gefäße.“
        </p>
        <p class="cosmos__source" data-reveal="fade">
          Thomas Wagner, »Die aufgehobene Zeit?«
        </p>
      </SectionHead>
      <div class="cosmos__floor">
        <div class="cosmos__stage" data-cosmos>
          <canvas
            class="cosmos__canvas"
            role="img"
            aria-label="Neunundneunzig Schalen von oben gesehen, in einem Ring um eine leere Mitte angeordnet, jede mit eigener Glasur"
          ></canvas>
          <div class="cosmos__center">
            <p class="cosmos__count" data-cosmos-readout>
              99 Schalen
            </p>
            <p class="cosmos__show">Zu sehen im Museum für Ostasiatische Kunst, Köln, bis 25. Oktober 2026</p>
            <LinkArrow href="/aktuelles#kosmos">Zur Ausstellung</LinkArrow>
          </div>
        </div>
        <div class="cosmos__caption">
          <p class="cosmos__show">Zu sehen im Museum für Ostasiatische Kunst, Köln, bis 25. Oktober 2026</p>
          <LinkArrow href="/aktuelles#kosmos">Zur Ausstellung</LinkArrow>
        </div>
      </div>
    </section>

    {/* Manufaktur */}
    <section class="craft" id="manufaktur" aria-labelledby="craft-title">
      <SectionHead typ="start" titelId="craft-title">
        <Fragment slot="titel">Keiner Mode, keinem Zeitgeist unterworfen.</Fragment>
        <p data-reveal="fade">
          Unter Rückbesinnung auf die Grundprinzipien des Bauhauses entwickelte Young-Jae Lee mit Hildegard Eggemann,
          Michael Schmandt und Claudia Neumann die Formensprache des Manufakturprogramms: zuerst 25 Grundelemente eines
          Geschirrs – Teller, Schalen, Krüge.
        </p>
        <p class="craft__rule" data-reveal="fade">
          „Jedes Stück muss gut zu drehen sein und auch zu benutzen. Alle Teile eines Geschirrs, gleich welcher Farbe,
          sollten miteinander kombinierbar sein.“
        </p>
      </SectionHead>

      <SigFarbskala glasuren={glasuren} />
      <p class="scale__note grid">
        <span>
          In monatelangen Experimenten entstand die sechstonige Farbskala – von Schattierungen des Jadegrün über ein
          gebrochenes Weiß bis zu Rostbraun.
        </span>
      </p>

      <div class="craft__detail craft__detail--wide grid">
        <Figure class="craft__media" unterschrift="Vor dem ersten Brand · Foto: Haydar Koyupinar">
          <Bild
            src="/img/kwm/regal.webp"
            width="954"
            height="905"
            loading="lazy"
            alt="Regal voller ungebrannter Tassen, Schalen, Teller und Krüge aus dem Manufakturprogramm"
          />
        </Figure>
        <FactsTable fakten={kurzfakten}>
          <Button href="/manufaktur">Zum Programm</Button>
        </FactsTable>
        <Figure class="craft__media3">
          <Bild
            src="/img/kwm/kannen.webp"
            width="600"
            height="400"
            loading="lazy"
            sizes="(min-width: 900px) 33vw, 100vw"
            alt="Zwei Krüge und eine Tasse aus dem Manufakturprogramm in Hellgrün, Weiß und Dunkelgrün"
          />
        </Figure>
      </div>
    </section>

    {/* Feuer: Text bleibt beim Scrollen auf dem Glasurfoto stehen */}
    <SigSticky variante="feuer" als="section" id="feuer" aria-labelledby="feuer-title">
      {/* sizes: Bildbreite folgt aus der Kastenhöhe (cover), Höhe x 1,12 (Überstand) x 1,5; Desktop 160vh, mobil 150vh */}
      <Bild
        slot="bild"
        class="sticky-bild__img"
        src="/img/03-glasur-detail.webp"
        sizes="(max-width: 900px) max(100vw, 252vh), max(100vw, 269vh)"
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
        alt="Nahaufnahme eines Schalenrands mit tintenblauer bis seladonfarbener Glasur, Nadelstichen und Eisensprenkeln"
      />
      <div class="sticky-bild__text">
        <h2 class="h2" id="feuer-title">
          Neun bis zehn Stunden Feuer.
        </h2>
        <p class="sticky-bild__lede">
          Im Holzofen wird über neun bis zehn Stunden kontinuierlich bis auf {grad(BRENNTEMPERATUR.holzbrandMax)}{' '}
          gefeuert – für einen Brand braucht es etwa 1,5 Festmeter Holz. Die Tönung wird reicher, manche Verfärbung
          lässt sich nicht steuern.
        </p>
        <LinkArrow href="/werkstatt#feuer">Wie die Glasur ihre Farbe bekommt</LinkArrow>
      </div>
    </SigSticky>

    {/* Werkstatt / Chronik */}
    <Chronicle
      eintraege={chronik}
      kurz
      id="werkstatt"
      titelId="chron-title"
      titel="Hundert Jahre an der Scheibe."
      lede="Von der Siedlungswerkstatt in Essen zur Manufaktur auf Zollverein: neun Stationen in 82 Jahren."
      link={{ href: '/werkstatt', text: 'Werkstatt, Team und Chronik' }}
    />

    {/* Besuch */}
    <section class="visit" id="besuch" aria-labelledby="visit-title">
      <SectionHead typ="start" titelId="visit-title">
        <Fragment slot="titel">Die Werkstatt ist offen.</Fragment>
        <p data-reveal="fade">
          Wenn Sie Stücke aus unserem Programm erwerben möchten, senden wir Ihnen gerne weitere Informationen oder ein
          Angebot zu. Oder Sie kommen vorbei.
        </p>
      </SectionHead>
      <div class="visit__body grid">
        <div class="visit__info">
          <Hours typ="tabelle" />
          <p class="visit__actions">
            <LinkArrow href={kontakt.telefonHref}>Lieber anrufen: {kontakt.telefon}</LinkArrow>
            <LinkArrow href="/besuch">Anfahrt und Besuch</LinkArrow>
          </p>
        </div>
        <div class="visit__form" id="anfrage">
          <InquiryForm />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
