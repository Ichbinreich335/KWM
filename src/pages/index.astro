---
import '../styles/basis.css';
import Statement from '../components/Statement.astro';
import SectionHead from '../components/SectionHead.astro';
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import '../styles/signaturen/signaturen.css';
---

<BaseLayout
  title="Keramische Werkstatt Margaretenhöhe · seit 1924"
  description="Gedrehte Gefäße von Young-Jae Lee und ein Manufakturprogramm nach den Formprinzipien des Bauhauses. Keramische Werkstatt Margaretenhöhe, Zeche Zollverein, Essen."
  bodyClass="page-home"
>
  <main id="inhalt">
    {/* Einstieg: Zitat links, Kummerschalen rechts (hell) */}
    <section class="hero grid" id="top" aria-labelledby="hero-title">
      <figure class="hero__media" data-reveal="img">
        <Bild
          priority
          src="/img/kwm/kummerschalen.webp"
          width="937"
          height="1040"
          alt="Viele flache Schalen von Young-Jae Lee auf einem Steinboden, seladonblau, schwarz gesprenkelt und rotbraun glasiert"
          data-parallax
        />
        <figcaption class="hero__credit">Kummerschalen · Foto: Christopher Clem Franken</figcaption>
      </figure>
      <div class="hero__text">
        <h1 class="hero__title" id="hero-title" data-reveal="words">
          Immer sind es Schalen, und doch ist keine wie die andere.
        </h1>
        <p class="hero__source" data-reveal="fade">
          Thomas Wagner über die Schalen von Young-Jae Lee
        </p>
        <p class="hero__intro" data-reveal="fade">
          Keramische Werkstatt Margaretenhöhe. Gedrehte Gefäße und Gebrauchsgeschirr aus Essen – seit 1924, heute auf
          dem Gelände der Zeche Zollverein.
        </p>
        <p class="hero__actions" data-reveal="fade">
          <a class="link-arrow" href="/meisterstuecke">
            Meisterstücke ansehen
          </a>
          <a class="link-arrow" href="/manufaktur">
            Manufakturprogramm
          </a>
        </p>
      </div>
    </section>

    {/* Aktuell: laufende und kommende Ausstellungen mit Flyer und Angaben, aufklappbar ohne Unterseite */}
    <section class="aktuell" id="aktuelles" data-sig="aktuell" aria-labelledby="aktuell-title">
      <div class="aktuell__head grid">
        <h2 class="h2" id="aktuell-title" data-reveal="words">
          Aktuell
        </h2>
        <a class="link-arrow aktuell__all" href="/aktuelles">
          Alle Ausstellungen und Termine
        </a>
      </div>

      <p class="aktuell__note" data-start="2026-10-01" data-end="2026-10-04">
        Am Samstag, 3. Oktober 2026 bleibt die Werkstatt geschlossen. Ab Montag, 5. Oktober sind wir wieder wie gewohnt
        für Sie da.
      </p>

      <ol class="aktuell__list">
        <li class="aktuell__item" data-spotlight data-start="2026-04-23" data-end="2026-10-25">
          <figure class="aktuell__media">
            <span class="aktuell__frame">
              <Bild
                src="/img/kwm/aktuell/mok-2000.webp"
                widths={[960, 1400, 2000]}
                sizes="(min-width: 900px) 64vw, 100vw"
                width="1400"
                height="652"
                alt="Vier Schalen von Young-Jae Lee: ochsenblutrot, weiß mit blauem Tupfen, rosé und hellbraun"
                loading="lazy"
                decoding="async"
              />
            </span>
            <figcaption>Schalen von Young-Jae Lee</figcaption>
          </figure>
          <div class="aktuell__body">
            <p class="aktuell__status" data-status>
              Läuft · bis 25. Oktober
            </p>
            <h3 class="aktuell__title">„99 Schalen – ein Kosmos“</h3>
            <p class="aktuell__place">Museum für Ostasiatische Kunst (MOK), Köln</p>
            <div class="aktuell__details">
              <p class="aktuell__text">Schalen von Young-Jae Lee im Museum für Ostasiatische Kunst in Köln.</p>
              <dl class="aktuell__facts">
                <div>
                  <dt>Zeitraum</dt>
                  <dd>23. April bis 25. Oktober 2026</dd>
                </div>
                <div>
                  <dt>Adresse</dt>
                  <dd>
                    Universitätsstraße 100
                    <br />
                    50674 Köln
                  </dd>
                </div>
              </dl>
              <a class="link-arrow" href="https://museum-fuer-ostasiatische-kunst.de/99-Schalen-ein-Kosmos">
                Zur Ausstellung im MOK
              </a>
            </div>
          </div>
        </li>

        <li class="aktuell__item" data-start="2026-08-16" data-end="2026-10-31">
          <figure class="aktuell__media">
            <span class="aktuell__frame">
              <Bild
                src="/img/kwm/aktuell/wesel-seladon-800.webp"
                widths={[640, 800]}
                sizes="(min-width: 900px) 31vw, 100vw"
                width="640"
                height="480"
                alt="Flache Schalen von Young-Jae Lee mit seladonfarbener Glasur, die sich in der Mitte sammelt"
                loading="lazy"
                decoding="async"
              />
            </span>
            <figcaption>Foto: Christopher Clem Franken</figcaption>
          </figure>
          <div class="aktuell__body">
            <p class="aktuell__status" data-status>
              Läuft · bis 31. Oktober
            </p>
            <h3 class="aktuell__title">„Kummerschalen“</h3>
            <p class="aktuell__place">Willibrordi-Dom, Wesel</p>
            <button class="aktuell__more" type="button" aria-expanded="false" aria-controls="aktuell-wesel" data-more>
              <span class="aktuell__more-label" data-label="Mehr zur Ausstellung">
                Mehr zur Ausstellung
              </span>
            </button>
            <div class="aktuell__panel" id="aktuell-wesel" role="region" aria-label="Details zu „Kummerschalen“">
              <div class="aktuell__panel-in">
                <p class="aktuell__text">
                  Der Niederrheinische Kunstverein zeigt in Kooperation mit der Evangelischen Kirchengemeinde Wesel
                  handgefertigte Schalen der international renommierten Keramikerin Young-Jae Lee.
                </p>
                <dl class="aktuell__facts">
                  <div>
                    <dt>Zeitraum</dt>
                    <dd>16. August bis 31. Oktober 2026</dd>
                  </div>
                  <div>
                    <dt>Eröffnung</dt>
                    <dd>
                      Sonntag, 16. August 2026, 11 Uhr Gottesdienst zur Ausstellung, 12.15 Uhr Eröffnung der
                      Ausstellung.
                    </dd>
                  </div>
                  <div>
                    <dt>Öffnungszeiten</dt>
                    <dd>
                      Di–So 14.30–17.00 Uhr
                      <br />
                      Mi und Sa 10–12 Uhr
                    </dd>
                  </div>
                  <div>
                    <dt>Adresse</dt>
                    <dd>
                      Großer Markt
                      <br />
                      46483 Wesel
                    </dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        </li>

        <li class="aktuell__item" data-start="2026-10-03" data-end="2026-12-12">
          <figure class="aktuell__media">
            <span class="aktuell__frame">
              <Bild
                src="/img/kwm/aktuell/greve-533.webp"
                width="533"
                height="400"
                alt="Türkisfarbene Kumme von Young-Jae Lee mit feinem Craquelé"
                loading="lazy"
                decoding="async"
              />
            </span>
            <figcaption>Kumme von Young-Jae Lee</figcaption>
          </figure>
          <div class="aktuell__body">
            <p class="aktuell__status" data-status>
              Ab 3. Oktober
            </p>
            <h3 class="aktuell__title">„Kathleen Jacobs / Young&#8209;Jae Lee“</h3>
            <p class="aktuell__place">Galerie Karsten Greve, St. Moritz, Schweiz</p>
            <button class="aktuell__more" type="button" aria-expanded="false" aria-controls="aktuell-greve" data-more>
              <span class="aktuell__more-label" data-label="Mehr zur Ausstellung">
                Mehr zur Ausstellung
              </span>
            </button>
            <div
              class="aktuell__panel"
              id="aktuell-greve"
              role="region"
              aria-label="Details zu „Kathleen Jacobs / Young-Jae Lee“"
            >
              <div class="aktuell__panel-in">
                <p class="aktuell__text">
                  Malerei von Kathleen Jacobs (Öl auf Leinen) und Keramik von Young&#8209;Jae Lee.
                </p>
                <dl class="aktuell__facts">
                  <div>
                    <dt>Zeitraum</dt>
                    <dd>3. Oktober bis 12. Dezember 2026</dd>
                  </div>
                </dl>
                <a class="link-arrow" href="https://galerie-karsten-greve.com/">
                  Galerie Karsten Greve
                </a>
              </div>
            </div>
          </div>
        </li>

        <li class="aktuell__item" data-start="2026-11-06" data-end="2026-11-08">
          <figure class="aktuell__media">
            <span class="aktuell__frame">
              <Bild
                src="/img/kwm/aktuell/popup-954.webp"
                widths={[640, 954]}
                sizes="(min-width: 900px) 31vw, 100vw"
                width="640"
                height="480"
                alt="Regal voller ungebrannter Becher, Schalen, Teller und Kannen in der Werkstatt"
                loading="lazy"
                decoding="async"
              />
            </span>
            <figcaption>In der Werkstatt · Foto: Haydar Koyupinar</figcaption>
          </figure>
          <div class="aktuell__body">
            <p class="aktuell__status" data-status>
              Ab 6. November
            </p>
            <h3 class="aktuell__title">Mode, Taschen, Keramik &amp; Licht im Dialog</h3>
            <p class="aktuell__place">Pop-up-Store Vol. 2 in der Werkstatt, Zeche Zollverein</p>
            <button class="aktuell__more" type="button" aria-expanded="false" aria-controls="aktuell-popup" data-more>
              <span class="aktuell__more-label" data-label="Mehr erfahren">
                Mehr erfahren
              </span>
            </button>
            <div
              class="aktuell__panel"
              id="aktuell-popup"
              role="region"
              aria-label="Details zu Mode, Taschen, Keramik und Licht im Dialog"
            >
              <div class="aktuell__panel-in">
                <p class="aktuell__text">Pop-up-Store in den Räumen der Keramischen Werkstatt Margaretenhöhe.</p>
                <dl class="aktuell__facts">
                  <div>
                    <dt>Zeitraum</dt>
                    <dd>6. bis 8. November 2026</dd>
                  </div>
                  <div>
                    <dt>Geöffnet</dt>
                    <dd>
                      Fr und Sa 11–18 Uhr
                      <br />
                      So 11–16 Uhr
                    </dd>
                  </div>
                  <div>
                    <dt>In Kooperation mit</dt>
                    <dd>
                      Burggraf Burggraf (Taschen)
                      <br />
                      Joachim Kern (Mode)
                      <br />
                      Christiane Kuntz (Mode)
                      <br />
                      Dietrich Pampus (Vintage Leuchten)
                    </dd>
                  </div>
                  <div>
                    <dt>Adresse</dt>
                    <dd>
                      Bullmannaue 19
                      <br />
                      45327 Essen, Gelände der Zeche Zollverein
                    </dd>
                  </div>
                </dl>
                <a class="link-arrow" href="/besuch">
                  Anfahrt zur Werkstatt
                </a>
              </div>
            </div>
          </div>
        </li>
      </ol>
    </section>

    {/* Lede */}
    <section class="lede grid" aria-label="Über die Werkstatt">
      <Statement typ="lede" als="p" class="lede__text">
        Aus der ständigen Wiederholung einer handwerklichen Technik, dem Drehen auf der Töpferscheibe, erwächst die
        vollkommene Schönheit einer Form.
      </Statement>
      <p class="lede__col lede__col--a" data-reveal="fade">
        1924 auf Initiative von Margarete Krupp für die Siedlung Margaretenhöhe gegründet. Seit 1927 den Formprinzipien
        des Bauhauses verpflichtet – über Otto Lindigs Schüler Johannes Leßmann.
      </p>
      <p class="lede__col lede__col--b" data-reveal="fade">
        Seit 1986 geprägt von Young-Jae Lee: Meisterstücke aus ihrer eigenen Hand und ein Geschirr, das seitdem nahezu
        unverändert in der Werkstatt gedreht wird.
      </p>
      <nav class="lines" aria-label="Zwei Linien der Werkstatt">
        <a class="lines__item" href="/meisterstuecke" data-reveal="fade">
          <span class="lines__name">Meisterstücke</span>
          <span class="lines__what">Unikate aus der Hand von Young-Jae Lee: Schalen, Kummen, Vasen</span>
        </a>
        <a class="lines__item" href="/manufaktur" data-reveal="fade">
          <span class="lines__name">Manufaktur</span>
          <span class="lines__what">Geschirr nach Bauhaus-Formprinzipien, in der Werkstatt gedreht und glasiert</span>
        </a>
      </nav>
    </section>

    {/* Young-Jae Lee */}
    <section class="artist" id="young-jae-lee" aria-labelledby="artist-title">
      <h2 class="artist__name grid" id="artist-title">
        <span data-reveal="words">Young-Jae Lee</span>
      </h2>
      <figure class="sticky-bild-wrap">
        <div class="sticky-bild sticky-bild--portrait" data-sig="sticky">
          <div class="sticky-bild__media">
            {/* sizes: Bildbreite folgt aus der Kastenhöhe (cover), Höhe x 1,12 (Überstand) x 2000/1313; mobil und hochkant 4:5 = 125vw, Desktop 140vh */}
            <Bild
              class="sticky-bild__img"
              src="/img/kwm/portrait-yjl.webp"
              sizes="(max-width: 900px) 213vw, (orientation: portrait) 213vw, max(100vw, 239vh)"
              width="2000"
              height="1313"
              loading="lazy"
              decoding="async"
              alt="Young-Jae Lee in der Werkstatt, vor ihr ungebrannte Schalen und Vasen, hinter ihr Regale voller Gefäße"
            />
          </div>
          <div class="sticky-bild__pane grid">
            <Statement
              typ="zitat-bild"
              einblendung="keine"
              class="sticky-bild__text sticky-bild__quote"
              quelle="Barbara Catoir, »Gespannte Lebendigkeit«"
            >
              „Sie erzählte von den Zeremonien in den Tempeln, dem Ritual eines hundertfachen Niederkniens,
              Niederfallens vor den Buddha-Statuen. Sie erzählte von ihrer Großmutter, die sich diesen
              geistig-körperlichen Übungen bis ins hohe Alter unterzog. Daran habe sie sich immer wieder erinnert,
              während sie ihre Schalen drehte, eine nach der anderen, ohne je darüber müde zu werden.“
            </Statement>
          </div>
        </div>
        <figcaption class="sticky-bild__caption">Young-Jae Lee in der Keramischen Werkstatt Margaretenhöhe</figcaption>
      </figure>

      <div class="artist__body grid">
        <Statement typ="zitat" einblendung="fade" class="artist__quote" quelle="Gisela Jahn">
          „Die minimale Veränderung ist Young-Jae Lees unbegrenzter Freiraum – in der Form wie in der Farbigkeit der
          Glasur und der Bemalung. Ihr geht es nicht um Formerfindung, sondern um die Individualität des Gefäßes.“
        </Statement>
        <p class="artist__heritage" data-reveal="fade">
          Zwei Traditionen treffen sich in ihren Gefäßen: die Ideen des Bauhauses, denen sie sich verpflichtet fühlt –
          und ihr koreanisches Erbe, „das heitere, schwerelose Empfinden für die Form und die subtilen Farben“.
          <span class="artist__cite">Gisela Jahn, »Gefäße drehen, Gefäße betrachten, Gefäße benutzen«</span>
        </p>
      </div>

      <div class="journey-track" data-journey-track>
        <div class="journey-stage">
          <ol class="journey grid" aria-label="Lebensweg">
            <li>
              <span class="journey__year">1951</span>
              <span class="journey__place">Seoul</span>
              <span class="journey__what">geboren; Studium an der Hochschule für Kunsterziehung</span>
            </li>
            <li>
              <span class="journey__year">1973</span>
              <span class="journey__place">Wiesbaden</span>
              <span class="journey__what">Keramik bei Margot Münster, Formgestaltung bei Erwin Schutzbach</span>
            </li>
            <li>
              <span class="journey__year">1978</span>
              <span class="journey__place">Sandhausen</span>
              <span class="journey__what">eigene Werkstatt bei Heidelberg</span>
            </li>
            <li>
              <span class="journey__year">1987</span>
              <span class="journey__place">Essen</span>
              <span class="journey__what">Leitung der Keramischen Werkstatt Margaretenhöhe</span>
            </li>
            <li>
              <span class="journey__year">2016</span>
              <span class="journey__place">Breslau</span>
              <span class="journey__what">Ehrendoktorwürde der Eugeniusz-Geppert-Akademie</span>
            </li>
          </ol>
          <p class="journey__all grid">
            <a class="link-arrow" href="/young-jae-lee#biografie">
              Zum ganzen Werdegang
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* Meisterstücke */}
    <section class="works" id="meisterstuecke" aria-labelledby="works-title">
      <SectionHead typ="start" titelId="works-title">
        <Fragment slot="titel">Meisterstücke</Fragment>
        <a class="link-arrow" href="/meisterstuecke">
          Alle Meisterstücke
        </a>
      </SectionHead>
      <div class="works__feature grid">
        <figure class="works__single" data-reveal="img">
          <Bild
            src="/img/kwm/werke/spindelvase-einzeln-1200.webp"
            width="1200"
            height="1200"
            loading="lazy"
            sizes="(min-width: 900px) 55vw, 100vw"
            alt="Weiße Spindelvase mit weiter Schulter und schmalem Fuß auf hellem Grund"
          />
        </figure>
        <div class="works__single-text">
          <Statement typ="aussage" als="p" class="works__statement">
            Alle Meisterstücke stammen aus der Hand Young-Jae Lees – von ihr selbst gedreht, bemalt und glasiert.
          </Statement>
          <div class="works__single-meta">
            <p class="works__single-name" data-reveal="fade">
              Spindelvase <span>2006/07</span>
            </p>
            <a
              class="link-arrow"
              href="/besuch?stueck=Spindelvase%20%28H%2035%2C5%20cm%2C%20D%2037%20cm%20%C2%B7%20Petalit-Eichenasche-Feldspat-Glasur%20%C2%B7%20Holzofen%201260%20%C2%B0C%20%C2%B7%20Reduktion%29#anfrage"
              data-reveal="fade"
            >
              Zu diesem Stück anfragen
            </a>
          </div>
        </div>
      </div>
      <ol class="works__grid grid">
        <li class="piece">
          <a href="/meisterstuecke#kummen">
            <span class="piece__media">
              <Bild
                src="/img/kwm/kumme_2.webp"
                width="600"
                height="400"
                loading="lazy"
                alt="Zwei Kummen mit blau gesprenkelter Glasur"
              />
            </span>
            <span class="piece__head">
              <span class="piece__name">Kumme</span>
              <span class="piece__year">1995</span>
            </span>
            <span class="piece__spec">H 18 cm, D 14,6 cm</span>
            <span class="piece__spec">Petalit-Eichenasche-Glasur · Holzofen</span>
          </a>
        </li>
        <li class="piece">
          <a href="/meisterstuecke#schalen">
            <span class="piece__media">
              <Bild
                src="/img/kwm/schale_spitz_xxl_1.webp"
                width="600"
                height="400"
                loading="lazy"
                alt="Große spitze Schale mit rosa Glasurverlauf"
              />
            </span>
            <span class="piece__head">
              <span class="piece__name">Schale, spitz, XXL</span>
              <span class="piece__year">2003–05</span>
            </span>
            <span class="piece__spec">H 10,5 cm, D 22,5 cm</span>
            <span class="piece__spec">Petalit-Eichenasche-Glasur</span>
          </a>
        </li>
        <li class="piece">
          <a href="/meisterstuecke#vasen">
            <span class="piece__media">
              <Bild
                src="/img/kwm/zylindervasen_gross.webp"
                width="600"
                height="400"
                loading="lazy"
                alt="Drei große Zylindervasen mit Pinselbemalung"
              />
            </span>
            <span class="piece__head">
              <span class="piece__name">Zylindervasen, groß</span>
              <span class="piece__year">2003</span>
            </span>
            <span class="piece__spec">H ca. 30 cm, D ca. 11,5 cm</span>
            <span class="piece__spec">Petalit-Eichenasche-Glasur · Holzofen</span>
          </a>
        </li>
        <li class="piece">
          <a href="/meisterstuecke#schalen">
            <span class="piece__media">
              <Bild
                src="/img/kwm/schale_spitz_xl_1.webp"
                width="600"
                height="400"
                loading="lazy"
                alt="Spitze Schale mit hellblauer Innenglasur"
              />
            </span>
            <span class="piece__head">
              <span class="piece__name">Schale, spitz, XL</span>
              <span class="piece__year">2003–05</span>
            </span>
            <span class="piece__spec">H 10,5 cm, D 21,5 cm</span>
            <span class="piece__spec">Strontium-Feldspat-Glasur</span>
          </a>
        </li>
        <li class="piece">
          <a href="/meisterstuecke#kummen">
            <span class="piece__media">
              <Bild
                src="/img/kwm/kumme_3.webp"
                width="600"
                height="400"
                loading="lazy"
                alt="Hellblaue Bettelmönchschale"
              />
            </span>
            <span class="piece__head">
              <span class="piece__name">Bettelmönchschale</span>
              <span class="piece__year">1988</span>
            </span>
            <span class="piece__spec">H 10,2 cm, D 13,6 cm</span>
            <span class="piece__spec">Barium-Feldspat-Glasur · Gasofen</span>
          </a>
        </li>
        <li class="piece">
          <a href="/meisterstuecke#schalen">
            <span class="piece__media">
              <Bild
                src="/img/kwm/schale_spitz_gross.webp"
                width="600"
                height="400"
                loading="lazy"
                alt="Spitze Schale mit türkisgrüner Glasur auf kleinem Fuß"
              />
            </span>
            <span class="piece__head">
              <span class="piece__name">Schale, spitz, groß</span>
              <span class="piece__year">2003–05</span>
            </span>
            <span class="piece__spec">H 10,3 cm, D 18,8 cm</span>
            <span class="piece__spec">Barium-Feldspat-Glasur</span>
          </a>
        </li>
      </ol>
    </section>

    {/* Orte: Ausstellungsorte im Bildraster (src/scripts/sig-orte.ts) */}
    <section class="orte" id="orte" data-sig="orte" aria-labelledby="orte-title">
      <div class="orte__head grid">
        <h2 class="h2" id="orte-title" data-reveal="words">
          Ausstellungsorte
        </h2>
        <div class="orte__aside">
          <p data-reveal="fade">Ausstellungen seit 1980 in Europa, Korea, Japan und den USA.</p>
          <a class="link-arrow" href="/young-jae-lee#ausstellungen">
            Alle Ausstellungen
          </a>
