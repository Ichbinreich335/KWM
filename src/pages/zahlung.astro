---
import '../styles/basis.css';
import '../styles/seiten/page-text.css';
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryBand from '../components/InquiryBand.astro';
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import Figure from '../components/Figure.astro';
import { kontakt } from '../data/kontakt';

/** Anzeigegröße des QR-Codes in Pixeln (Quelle ist größer, siehe page-text.css) */
const QR_GROESSE = 177;
---

<BaseLayout
  title="Zahlungsmöglichkeiten · Keramische Werkstatt Margaretenhöhe"
  description="Zahlung per Banküberweisung oder PayPal bei der Keramischen Werkstatt Margaretenhöhe."
  bodyClass="page-text"
>
  <main id="inhalt">
    <PageHero typ="name" textseite>
      <Fragment slot="titel">Zahlungsmöglichkeiten</Fragment>
      <Fragment slot="lede">Per Überweisung oder PayPal.</Fragment>
    </PageHero>

    <div class="legal grid">
      <aside class="legal__aside ts-small">
        <nav aria-label="Rechtliches und Service">
          <p class="legal__label ts-meta">Rechtliches</p>
          <ul>
            <li>
              <a href="/impressum">Impressum</a>
            </li>
            <li>
              <a href="/datenschutz">Datenschutz</a>
            </li>
            <li>
              <a href="/agb">AGB</a>
            </li>
            <li>
              <a href="/versand">Verpackung und Transport</a>
            </li>
            <li>
              <a href="/zahlung" aria-current="page">
                Zahlung
              </a>
            </li>
          </ul>
        </nav>
      </aside>
      <Prose>
        <div class="pay-text">
          <section class="pay-text__item" aria-labelledby="zahl-bank">
            <h2 id="zahl-bank">Banküberweisung</h2>
            <p>
              Sparkasse Essen
              <br />
              IBAN DE84 3605 0105 0000 2649 37
            </p>
          </section>
          <section class="pay-text__item" aria-labelledby="zahl-paypal">
            <h2 id="zahl-paypal">PayPal</h2>
            <p>{kontakt.mail}</p>
            <Figure class="pay-text__qr" einblenden={false}>
              <Bild
                src="/img/kwm/paypal-qr.webp"
                widths={[QR_GROESSE, QR_GROESSE * 2, 423]}
                sizes={`${QR_GROESSE}px`}
                width={QR_GROESSE}
                height={QR_GROESSE}
                alt={`QR-Code für die Zahlung per PayPal an ${kontakt.mail}`}
                loading="lazy"
              />
            </Figure>
          </section>
        </div>
      </Prose>
    </div>

    <InquiryBand text="Fragen zur Zahlung? Wir helfen gern weiter." />
  </main>
</BaseLayout>
