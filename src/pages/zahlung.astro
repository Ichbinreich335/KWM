---
import Bild from '../components/Bild.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryBand from '../components/InquiryBand.astro';
import '../styles/basis.css';
import '../styles/seiten/page-text.css';
import '../styles/signaturen/signaturen.css';
---

<BaseLayout
  title="Zahlungsmöglichkeiten · Keramische Werkstatt Margaretenhöhe"
  description="Zahlung per Banküberweisung oder PayPal bei der Keramischen Werkstatt Margaretenhöhe."
  bodyClass="page-text"
>
  <main id="inhalt">
    <section class="page-hero page-hero--name page-hero--text grid" aria-labelledby="page-title">
      <h1 class="page-hero__title" id="page-title" data-reveal="words">
        Zahlungsmöglichkeiten
      </h1>
      <p class="page-hero__lede" data-reveal="fade">
        Per Überweisung oder PayPal.
      </p>
    </section>

    <div class="legal grid">
      <aside class="legal__aside">
        <nav aria-label="Rechtliches und Service">
          <p class="legal__label">Rechtliches</p>
          <ul>
            <li>
              <a href="/impressum">Impressum</a>
            </li>
            <li>
              <a href="/datenschutz">Datenschutz</a>
            </li>
            <li>
              <a href="/agb">AGB</a>
            </li>
            <li>
              <a href="/versand">Verpackung und Transport</a>
            </li>
            <li>
              <a href="/zahlung" aria-current="page">
                Zahlung
              </a>
            </li>
          </ul>
        </nav>
      </aside>
      <div class="legal__body">
        <div class="pay-text">
          <section class="pay-text__item" aria-labelledby="zahl-bank">
            <h2 id="zahl-bank">Banküberweisung</h2>
            <p>
              Sparkasse Essen
              <br />
              IBAN DE84 3605 0105 0000 2649 37
            </p>
          </section>
          <section class="pay-text__item" aria-labelledby="zahl-paypal">
            <h2 id="zahl-paypal">PayPal</h2>
            <p>kontakt@kwm1924.de</p>
            <figure class="pay-text__qr">
              <Bild
                src="/img/kwm/paypal-qr.webp"
                width="177"
                height="177"
                alt="QR-Code für die Zahlung per PayPal an kontakt@kwm1924.de"
                loading="lazy"
              />
            </figure>
          </section>
        </div>
      </div>
    </div>

    <InquiryBand text="Fragen zur Zahlung? Wir helfen gern weiter." />
  </main>
</BaseLayout>
