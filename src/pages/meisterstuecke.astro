---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryBand from '../components/InquiryBand.astro';
import '../styles/basis.css';
import '../styles/seiten/page-meisterstuecke.css';
import '../styles/signaturen/signaturen.css';
---

<BaseLayout
  title="Meisterstücke · Keramische Werkstatt Margaretenhöhe"
  description="Schalen, Kummen und Vasen aus der Hand von Young-Jae Lee – gedreht, bemalt und glasiert in der Keramischen Werkstatt Margaretenhöhe, Essen."
  bodyClass="page-meisterstuecke"
  nav="meisterstuecke"
>
  <main id="inhalt">
    <section class="page-hero page-hero--meta grid" aria-labelledby="ms-title">
      <h1 class="page-hero__title" id="ms-title" data-reveal="words">
        Meisterstücke
      </h1>
      <p class="page-hero__lede" data-reveal="fade">
        Alle hier gezeigten Meisterstücke stammen aus der Hand Young-Jae Lees und wurden von ihr selbst gedreht, bemalt
        und glasiert.
      </p>
      <figure class="page-hero__media" data-reveal="img">
        <img
          src="/img/kwm/schalen-trio.webp"
          srcset="/img/kwm/schalen-trio-800.webp 800w, /img/kwm/schalen-trio-1400.webp 1400w, /img/kwm/schalen-trio.webp 2000w"
          sizes="100vw"
          width="2000"
          height="931"
          fetchpriority="high"
          alt="Vier Schalen von Young-Jae Lee nebeneinander: tiefrot, weiß mit blauem Pinselpunkt, rosé-violett und hellbraun"
        />
        <figcaption>Schalen von Young-Jae Lee</figcaption>
      </figure>
    </section>

    <section class="ms-intro on-flaeche grid" aria-label="Über die Meisterstücke">
      <p class="ms-intro__statement" data-reveal="words">
        In Anlehnung an die koreanische Tradition: nicht die ständige Neuerfindung von Formen, sondern die vollkommene
        Beherrschung des vorhandenen Repertoires.
      </p>
      <div class="ms-intro__text">
        <p data-reveal="fade">
          Young-Jae Lee ist eine international anerkannte, mehrfach ausgezeichnete Künstlerin und leitet als
          Geschäftsführerin die Keramische Werkstatt Margaretenhöhe in Essen. Zusammen mit Hildegard Eggemann
          entwickelte sie ab 1986 den Formen- und Farbkanon des Manufakturprogramms, das seitdem nahezu unverändert von
          den Mitarbeitern der Werkstatt hergestellt wird.
        </p>
        <p data-reveal="fade">
          Die Herstellung jedes neuen Gefäßes gleicht einer Meditation. Erst mit der Verinnerlichung der Formen kann die
          tägliche Arbeit an der Drehscheibe jenseits aller Routine zu einer Art Exerzitium werden. Die Persönlichkeit
          beginnt einzufließen, das Individuelle drückt sich im Handwerklichen aus.
        </p>
      </div>
    </section>

    <nav class="subnav" aria-label="Kapitel dieser Seite">
      <a href="#schalen">Schalen</a>
      <a href="#arbeitsweise">Arbeitsweise</a>
      <a href="#kummen">Kummen</a>
      <a href="#vasen">Vasen</a>
